<UserControl x:Class="RetailBillingApp.Views.ChartOfAccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="Chart of Accounts" Style="{StaticResource HeadingTextBlock}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- Account Groups -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,15">
                        <TextBlock Text="Account Groups" Style="{StaticResource SubHeadingTextBlock}" />
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"
                              Style="{StaticResource DataGridStyle}" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,15,0,0">
                        <TextBlock Text="Add Group" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
                        <TextBox Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}" />
                        <ComboBox ItemsSource="{Binding AccountTypes}" SelectedItem="{Binding NewGroupType}"
                                  Style="{StaticResource BaseComboBox}" />
                        <Button Content="Add Group" Command="{Binding AddGroupCommand}"
                                Style="{StaticResource SuccessButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Width="120" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Accounts -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,15">
                        <TextBlock Text="Accounts" Style="{StaticResource SubHeadingTextBlock}" />
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding FilteredAccounts}" SelectedItem="{Binding SelectedAccount}"
                              Style="{StaticResource DataGridStyle}" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Type" Binding="{Binding AccountType}" Width="100" />
                            <DataGridTextColumn Header="Group" Binding="{Binding Group.Name, TargetNullValue='-', FallbackValue='-'}" Width="120" />
                            <DataGridTextColumn Header="Balance" Binding="{Binding CurrentBalance, StringFormat=C}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,15,0,0">
                        <TextBlock Text="Add Account" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
                        <TextBox Text="{Binding NewAccountName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}" />
                        <ComboBox ItemsSource="{Binding AccountTypes}" SelectedItem="{Binding NewAccountType}"
                                  Style="{StaticResource BaseComboBox}" />
                        <ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding NewAccountGroupId}"
                                  DisplayMemberPath="Name" SelectedValuePath="Id"
                                  Style="{StaticResource BaseComboBox}" />
                        <TextBox Text="{Binding NewOpeningBalance, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}" />
                        <Button Content="Add Account" Command="{Binding AddAccountCommand}"
                                Style="{StaticResource SuccessButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Width="120" />
                        <Button Content="Delete Selected" Command="{Binding DeleteAccountCommand}"
                                Style="{StaticResource DangerButton}" HorizontalAlignment="Left" Margin="10,10,0,0" Width="120" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                   FontSize="12" Margin="20,10,0,0" TextWrapping="Wrap" />
    </Grid>
</UserControl>
