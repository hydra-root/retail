<UserControl x:Class="RetailBillingApp.Views.OfflineSyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="780" d:DesignWidth="1240">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Offline Operation and Sync Queue" Style="{StaticResource HeadingTextBlock}" />
            <TextBlock Text="Local-first change queue: billing, stock and receipts keep running while the HQ endpoint is away, and every change is replayed in order once it answers"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,5,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="410" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" MinWidth="520" />
            </Grid.ColumnDefinitions>

            <!-- Status + switches -->
            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Status card -->
                    <Border Style="{StaticResource CardBorder}" VerticalAlignment="Top">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Sync Status" Style="{StaticResource SubHeadingTextBlock}" VerticalAlignment="Center" />
                                <Button Content="Refresh" Command="{Binding RefreshCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <TextBlock Text="{Binding ConnectionText}" TextWrapping="Wrap"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />

                            <Border Background="{StaticResource WarningBrush}" CornerRadius="4" Padding="10" Margin="0,10,0,0"
                                    Visibility="{Binding IsOffline, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Work continues locally: each invoice, adjustment and receipt is written to the queue below and nothing is sent until the link is back."
                                           TextWrapping="Wrap" FontSize="11" Foreground="White" />
                            </Border>

                            <TextBlock FontSize="12" Margin="0,12,0,2">
                                <Run Text="Pending: " FontWeight="SemiBold" /><Run Text="{Binding PendingCount, Mode=OneWay}" /><Run Text="  (queued + failed)" />
                            </TextBlock>
                            <TextBlock FontSize="12" Margin="0,2,0,2">
                                <Run Text="Queued: " FontWeight="SemiBold" /><Run Text="{Binding QueuedCount, Mode=OneWay}" /><Run Text="   Delivered: " /><Run Text="{Binding SyncedCount, Mode=OneWay}" /><Run Text="   Failed: " /><Run Text="{Binding FailedCount, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock FontSize="12" Margin="0,2,0,2">
                                <Run Text="Discarded: " FontWeight="SemiBold" /><Run Text="{Binding DiscardedCount, Mode=OneWay}" />
                            </TextBlock>

                            <TextBlock Margin="0,8,0,2" FontSize="12">
                                <TextBlock.Text>
                                    <Binding Path="TotalCount" StringFormat="Queue holds {0} row(s) in total" />
                                </TextBlock.Text>
                            </TextBlock>

                            <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0">
                                <Run Text="Last sync: " FontWeight="SemiBold" /><Run Text="{Binding LastSyncText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding LastResultText}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />

                            <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="Waiting since: " FontWeight="SemiBold" /><Run Text="{Binding OldestPendingText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="Next up: " FontWeight="SemiBold" /><Run Text="{Binding NextUpText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding AutoSyncText}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Switches -->
                    <Border Style="{StaticResource CardBorder}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Offline and Sync Settings" Style="{StaticResource SubHeadingTextBlock}" Margin="0,0,0,10" />

                            <CheckBox Content="Force offline (stop all sends)" IsChecked="{Binding IsForcedOffline}" Margin="0,0,0,10" />
                            <CheckBox Content="Enable automatic sync runs" IsChecked="{Binding AutoSyncEnabled}" Margin="0,0,0,14" />

                            <TextBlock Text="Automatic sync interval" FontSize="12" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding IntervalOptions}"
                                      SelectedItem="{Binding SelectedIntervalLabel}"
                                      Style="{StaticResource BaseComboBox}"
                                      HorizontalAlignment="Left" MinWidth="220" />

                            <TextBlock Text="Attempts per change before it is marked Failed" FontSize="12" Margin="0,8,0,4" />
                            <ComboBox ItemsSource="{Binding MaxAttemptOptions}"
                                      SelectedItem="{Binding SelectedMaxAttemptsLabel}"
                                      Style="{StaticResource BaseComboBox}"
                                      HorizontalAlignment="Left" MinWidth="220" />

                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="12" Margin="0,14,0,0">
                                <TextBlock Text="{Binding SyncSummary}"
                                           TextWrapping="Wrap" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>

                            <TextBlock Margin="0,12,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="Last change: " /><Run Text="{Binding LastChangedByText, Mode=OneWay}" />
                            </TextBlock>

                            <Button Content="Save Settings" Command="{Binding SaveSettingsCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    IsEnabled="{Binding IsDirty}"
                                    HorizontalAlignment="Left" MinWidth="140" Margin="0,16,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Change queue -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="220" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource SubHeadingTextBlock}" Margin="0,0,0,10">
                        <Run Text="Change Queue (" /><Run Text="{Binding QueueRowCount, Mode=OneWay}" /><Run Text=" shown)" />
                    </TextBlock>

                    <!-- toolbar -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="Status:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" />
                            <ComboBox ItemsSource="{Binding StatusFilters}"
                                      SelectedItem="{Binding SelectedStatusFilter}"
                                      Style="{StaticResource BaseComboBox}"
                                      MinWidth="130" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0">
                            <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" />
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource BaseTextBox}" MinWidth="200" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Sync Now" Command="{Binding SyncNowCommand}"
                                    Style="{StaticResource PrimaryButton}" MinWidth="110"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                            <Button Content="Retry Failed" Command="{Binding RetryFailedCommand}"
                                    Style="{StaticResource SuccessButton}" MinWidth="110"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                            <Button Content="Discard Selected" Command="{Binding DiscardSelectedCommand}"
                                    Style="{StaticResource DangerButton}" MinWidth="130"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                            <Button Content="Purge Synced" Command="{Binding PurgeSyncedCommand}"
                                    Style="{StaticResource SecondaryButton}" MinWidth="110"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredQueue}"
                              SelectedItem="{Binding SelectedChange, Mode=TwoWay}"
                              Style="{StaticResource DataGridStyle}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Entity" Binding="{Binding EntityType}" Width="120" />
                            <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="70" />
                            <DataGridTextColumn Header="Key" Binding="{Binding EntityKey}" Width="*" MinWidth="140" />
                            <DataGridTextColumn Header="Store" Binding="{Binding StoreLabel}" Width="90" />
                            <DataGridTextColumn Header="Tries" Binding="{Binding AttemptText}" Width="90" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" />
                            <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, StringFormat=dd-MMM-yyyy HH:mm}" Width="135" />
                            <DataGridTextColumn Header="Last attempt" Binding="{Binding LastAttemptText}" Width="140" />
                            <DataGridTemplateColumn Header="Last error" Width="260">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LastError}" TextWrapping="Wrap" FontSize="11"
                                                   Margin="4,2" VerticalAlignment="Center"
                                                   Foreground="{StaticResource ErrorBrush}"
                                                   ToolTip="{Binding StatusHint}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Discard"
                                                Command="{Binding DataContext.DiscardRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding IsReplayable}"
                                                Style="{StaticResource DangerButton}"
                                                FontSize="11" Padding="6,2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="3" Text="{Binding SelectedSummary}" TextWrapping="Wrap"
                               FontSize="12" FontWeight="SemiBold" Margin="0,14,0,6"
                               Foreground="{StaticResource TextPrimaryBrush}" />

                    <TextBox Grid.Row="4" Text="{Binding SelectedPayloadJson, Mode=OneWay}"
                             Style="{StaticResource BaseTextBox}"
                             IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" MaxHeight="220"
                             FontFamily="Consolas" FontSize="12" Margin="0,0,0,0" />
                </Grid>
            </Border>
        </Grid>

        <!-- Messages -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource SuccessBrush}"
                       FontSize="12" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                       FontSize="12" TextWrapping="Wrap" />
            <TextBlock Text="{Binding WarningsText}" Foreground="{StaticResource WarningBrush}"
                       FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
