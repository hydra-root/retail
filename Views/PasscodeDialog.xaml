<Window x:Class="RetailBillingApp.Views.PasscodeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Passcode Required"
        Width="420"
        Height="230"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        FocusManager.FocusedElement="{Binding ElementName=PasswordBox}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PrimaryDarkBrush}" Padding="20,12,20,10">
            <TextBlock x:Name="MessageText" FontSize="14" Foreground="White" TextWrapping="Wrap" />
        </Border>

        <StackPanel Grid.Row="1" Margin="20">
            <TextBlock Text="Passcode" FontWeight="SemiBold" Margin="0,0,0,6"
                       Foreground="{StaticResource TextSecondaryBrush}" />
            <PasswordBox x:Name="PasswordBox" Style="{StaticResource BasePasswordBox}" />
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}"
                       FontSize="12" Margin="0,8,0,0" Visibility="Collapsed"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,20">
            <Button Content="Confirm" IsDefault="True" Width="110" Click="Confirm_Click"
                    Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" />
            <Button Content="Cancel" IsCancel="True" Width="110" Click="Cancel_Click"
                    Style="{StaticResource SecondaryButton}" />
        </StackPanel>
    </Grid>
</Window>
