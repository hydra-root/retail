<UserControl x:Class="RetailBillingApp.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Reports &amp; Analytics" Style="{StaticResource HeadingTextBlock}" />
            <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel>

                <!-- Date Filter -->
                <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="From:" VerticalAlignment="Center" Grid.Column="0" Margin="0,0,10,0" />
                        <DatePicker SelectedDate="{Binding StartDate}" Grid.Column="1" Margin="0,0,20,0" />
                        <TextBlock Text="To:" VerticalAlignment="Center" Grid.Column="2" Margin="0,0,10,0" />
                        <DatePicker SelectedDate="{Binding EndDate}" Grid.Column="3" Margin="0,0,20,0" />
                    </Grid>
                </Border>

                <!-- RPT-13: whole-dashboard export -->
                <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Export Report" Style="{StaticResource SubHeadingTextBlock}" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Export Summary PDF" Command="{Binding ExportPdfCommand}" CommandParameter="Stats" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
                            <Button Content="Export Summary Excel" Command="{Binding ExportExcelCommand}" CommandParameter="Stats" Style="{StaticResource SecondaryButton}" />
                        </StackPanel>
                        <TextBlock Text="{Binding ExportMessage}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Dashboard Stats -->
                <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Dashboard Overview" Style="{StaticResource SubHeadingTextBlock}" Margin="0,0,0,15" />
                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Cash in Hand" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding Stats.CashInHand, StringFormat=C}" FontSize="20" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Stock Value" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding Stats.StockValue, StringFormat=C}" FontSize="20" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Daily Sales" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding Stats.DailySales, StringFormat=C}" FontSize="20" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Pending Dues" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding Stats.PendingDues, StringFormat=C}" FontSize="20" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Low Stock" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding Stats.LowStockCount}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" />
                        </StackPanel>
                    </Grid>
                    </StackPanel>
                </Border>

                <!-- GST Report -->
                <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="GST Report" Style="{StaticResource SubHeadingTextBlock}" Margin="0,0,0,15" />
                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Total Sales" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding GstReport.TotalSales, StringFormat=C}" FontSize="18" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Total Tax" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding GstReport.TotalTax, StringFormat=C}" FontSize="18" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Invoices" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding GstReport.InvoiceCount}" FontSize="18" FontWeight="Bold" />
                        </StackPanel>
                    </Grid>
                    </StackPanel>
                </Border>

                <!-- Receivables -->
                <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Receivables - Customer Dues" Style="{StaticResource SubHeadingTextBlock}" Margin="0,0,0,15" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Export PDF" Command="{Binding ExportPdfCommand}" CommandParameter="Receivables" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
                            <Button Content="Export Excel" Command="{Binding ExportExcelCommand}" CommandParameter="Receivables" Style="{StaticResource SecondaryButton}" />
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding Receivables}" Style="{StaticResource DataGridStyle}" AutoGenerateColumns="False" MaxHeight="250">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*" />
                                <DataGridTextColumn Header="Outstanding" Binding="{Binding OutstandingAmount, StringFormat=C}" Width="150" />
                                <DataGridTextColumn Header="Pending Invoices" Binding="{Binding PendingInvoices}" Width="150" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Stock Audit -->
                <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Stock Audit" Style="{StaticResource SubHeadingTextBlock}" Margin="0,0,0,15" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Export PDF" Command="{Binding ExportPdfCommand}" CommandParameter="StockAudit" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
                            <Button Content="Export Excel" Command="{Binding ExportExcelCommand}" CommandParameter="StockAudit" Style="{StaticResource SecondaryButton}" />
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding StockAudit}" Style="{StaticResource DataGridStyle}" AutoGenerateColumns="False" MaxHeight="250">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*" />
                                <DataGridTextColumn Header="Stock" Binding="{Binding StockQty}" Width="100" />
                                <DataGridTextColumn Header="Min Qty" Binding="{Binding MinStockQty}" Width="100" />
                                <DataGridTextColumn Header="Batch" Binding="{Binding Batch}" Width="100" />
                                <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryDate, StringFormat=yyyy-MM-dd}" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- RPT-13: Scheduled Email -->
                <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Scheduled Email Report" Style="{StaticResource SubHeadingTextBlock}" Margin="0,0,0,15" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Report:" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0" Margin="0,0,10,10" />
                            <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,20,10"
                                      ItemsSource="{Binding ReportChoices}"
                                      SelectedItem="{Binding ScheduledReportChoice}"
                                      DisplayMemberPath="Label" SelectedValuePath="Key" />

                            <TextBlock Text="Enabled:" VerticalAlignment="Center" Grid.Row="0" Grid.Column="2" Margin="0,0,10,10" />
                            <CheckBox IsChecked="{Binding ScheduleEnabled}" VerticalAlignment="Center" Grid.Row="0" Grid.Column="3" Margin="0,0,20,10" />

                            <TextBlock Text="Recipient:" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0" Margin="0,0,10,10" />
                            <TextBox Text="{Binding ScheduledRecipient, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" Margin="0,0,20,10" />

                            <TextBlock Text="Subject:" VerticalAlignment="Center" Grid.Row="1" Grid.Column="2" Margin="0,0,10,10" />
                            <TextBox Text="{Binding ScheduledSubject, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="3" Margin="0,0,20,10" />

                            <TextBlock Text="Run at hour (0-23):" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0" Margin="0,0,10,10" />
                            <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,20,10"
                                      ItemsSource="{Binding HourChoices}" SelectedItem="{Binding ScheduledHour}" />

                            <TextBlock Text="Minute (0-59):" VerticalAlignment="Center" Grid.Row="2" Grid.Column="2" Margin="0,0,10,10" />
                            <ComboBox Grid.Row="2" Grid.Column="3" Margin="0,0,20,10"
                                      ItemsSource="{Binding MinuteChoices}" SelectedItem="{Binding ScheduledMinute}" />

                            <TextBlock Text="Send day:" VerticalAlignment="Center" Grid.Row="3" Grid.Column="0" Margin="0,0,10,10" />
                            <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,0,20,10"
                                      ItemsSource="{Binding DayChoices}" SelectedItem="{Binding ScheduledDay}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <Button Content="Save Schedule" Command="{Binding SaveScheduleCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
                            <Button Content="Run Now" Command="{Binding RunScheduleNowCommand}" Style="{StaticResource SecondaryButton}" />
                        </StackPanel>

                        <TextBlock Text="{Binding ScheduleMessage}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding ScheduleStatusText}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
