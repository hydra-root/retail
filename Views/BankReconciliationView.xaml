<UserControl x:Class="RetailBillingApp.Views.BankReconciliationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header + toolbar -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Bank Reconciliation" Style="{StaticResource HeadingTextBlock}" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Import Statement CSV" Command="{Binding ImportCsvCommand}"
                        Style="{StaticResource PrimaryButton}" MinWidth="160" />
                <Button Content="Auto-Match" Command="{Binding AutoMatchCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" MinWidth="110" />
                <Button Content="Reconcile (Manual)" Command="{Binding ReconcileCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" MinWidth="140" />
                <Button Content="Clear Match" Command="{Binding ClearMatchCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" />
                <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="18,0,8,0" />
                <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding StatusFilter}"
                          Style="{StaticResource BaseComboBox}" MinWidth="130" />
                <Button Content="Refresh" Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- Summary cards -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,15">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="Statement Lines" Style="{StaticResource SubHeadingTextBlock}" FontSize="11" />
                    <TextBlock Text="{Binding Summary.TotalLines}" FontSize="20" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="Reconciled ✅" Style="{StaticResource SubHeadingTextBlock}" FontSize="11" />
                    <TextBlock Text="{Binding Summary.ReconciledLines}" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource SuccessBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="Unmatched" Style="{StaticResource SubHeadingTextBlock}" FontSize="11" />
                    <TextBlock Text="{Binding Summary.UnmatchedLines}" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource ErrorBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Padding="12">
                <StackPanel>
                    <TextBlock Text="Unmatched Value" Style="{StaticResource SubHeadingTextBlock}" FontSize="11" />
                    <TextBlock Text="{Binding Summary.UnmatchedAmount, StringFormat={}{0:C}}" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource ErrorBrush}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Statement grid -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SubHeadingTextBlock}" Margin="0,0,0,10"
                           Text="Bank Statement Lines (select a line, then Auto-Match or Reconcile)" />
                <DataGrid ItemsSource="{Binding Rows}" Style="{StaticResource DataGridStyle}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectedItem="{Binding SelectedLine}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding ValueDate, StringFormat=dd-MMM-yyyy}" Width="100" />
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                        <DataGridTextColumn Header="Reference" Binding="{Binding ReferenceNo}" Width="110" />
                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=C}" Width="120" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                        <DataGridTextColumn Header="Matched Via" Binding="{Binding MatchedType}" Width="100" />
                        <DataGridTextColumn Header="Matched To" Binding="{Binding MatchedRef}" Width="280" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Messages -->
        <StackPanel Grid.Row="4" Margin="0,10,0,0">
            <TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource SuccessBrush}"
                       FontSize="12" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                       FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
