<UserControl x:Class="RetailBillingApp.Views.BackupScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1100">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Automatic Backup Schedule" Style="{StaticResource HeadingTextBlock}" />
            <TextBlock Text="Daily / weekly copies on top of manual backup, with retention and a run-now button"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,5,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" MinWidth="400" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- Settings card -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" VerticalAlignment="Top">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="Schedule" Style="{StaticResource SubHeadingTextBlock}" Margin="0,0,0,10" />

                        <CheckBox Content="Enable automatic backups" IsChecked="{Binding IsEnabled}" Margin="0,4,0,12" />

                        <TextBlock Text="Frequency" FontSize="12" Margin="0,4,0,4" />
                        <ComboBox ItemsSource="{Binding Frequencies}"
                                  SelectedItem="{Binding SelectedFrequency}"
                                  Style="{StaticResource BaseComboBox}"
                                  HorizontalAlignment="Left" MinWidth="220" />

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Interval days (Every N days)" FontSize="12" Margin="0,4,0,4" />
                                <TextBox Text="{Binding IntervalDays, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource BaseTextBox}" MinWidth="90" HorizontalAlignment="Left" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Day of week (Weekly)" FontSize="12" Margin="0,4,0,4" />
                                <ComboBox ItemsSource="{Binding DaysOfWeek}"
                                          SelectedItem="{Binding SelectedDayOfWeek}"
                                          Style="{StaticResource BaseComboBox}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Run at hour (0-23)" FontSize="12" Margin="0,4,0,4" />
                                <TextBox Text="{Binding RunAtHour, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource BaseTextBox}" MinWidth="90" HorizontalAlignment="Left" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Run at minute (0-59)" FontSize="12" Margin="0,4,0,4" />
                                <TextBox Text="{Binding RunAtMinute, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource BaseTextBox}" MinWidth="90" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Destination folder (blank = default RetailBillingBackups)" FontSize="12" Margin="0,10,0,4" />
                        <TextBox Text="{Binding DestinationFolder, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}" MaxLength="500" />

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Copies to keep" FontSize="12" Margin="0,4,0,4" />
                                <TextBox Text="{Binding KeepGenerations, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource BaseTextBox}" MinWidth="90" HorizontalAlignment="Left" />
                            </StackPanel>

                            <CheckBox Grid.Column="1" Content="Include manual backups when pruning"
                                      IsChecked="{Binding IncludeManualBackups}"
                                      VerticalAlignment="Bottom" Margin="16,0,0,12" />
                        </Grid>

                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="12" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding ScheduleSummary}" TextWrapping="Wrap"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding NextRunPreview}" TextWrapping="Wrap"
                                           FontSize="12" Margin="0,6,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="Save Schedule" Command="{Binding SaveScheduleCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    IsEnabled="{Binding IsDirty}" MinWidth="140" />
                            <Button Content="Run Now" Command="{Binding RunNowCommand}"
                                    Style="{StaticResource SuccessButton}" MinWidth="110" />
                            <Button Content="Start" Command="{Binding StartSchedulerCommand}"
                                    Style="{StaticResource SecondaryButton}" MinWidth="90" />
                            <Button Content="Stop" Command="{Binding StopSchedulerCommand}"
                                    Style="{StaticResource DangerButton}" MinWidth="90" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Status + history -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Status card -->
                <Border Grid.Row="0" Style="{StaticResource CardBorder}" VerticalAlignment="Top">
                    <StackPanel Margin="12">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Status" Style="{StaticResource SubHeadingTextBlock}" VerticalAlignment="Center" />
                            <Button Content="Refresh" Command="{Binding RefreshCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock FontSize="12" Margin="0,2,0,2">
                            <Run Text="State: " FontWeight="SemiBold" /><Run Text="{Binding StateText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock FontSize="12" Margin="0,2,0,2">
                            <Run Text="Last run: " FontWeight="SemiBold" /><Run Text="{Binding LastRunText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding LastResultText}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBlock FontSize="12" Margin="0,2,0,2">
                            <Run Text="Next run: " FontWeight="SemiBold" /><Run Text="{Binding NextRunText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding CountdownText}" FontSize="12"
                                   Foreground="{StaticResource WarningBrush}" Margin="0,0,0,2" />
                    </StackPanel>
                </Border>

                <!-- Backup history -->
                <Border Grid.Row="1" Style="{StaticResource CardBorder}">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Margin="0,0,0,10" Style="{StaticResource SubHeadingTextBlock}">
                            <Run Text="Backup History (" /><Run Text="{Binding Backups.Count, Mode=OneWay}" /><Run Text=")" />
                        </TextBlock>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding Backups}"
                                  Style="{StaticResource DataGridStyle}"
                                  AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="*" />
                                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="100" />
                                <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, StringFormat=dd-MMM-yyyy HH:mm}" Width="150" />
                                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Messages -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource SuccessBrush}"
                       FontSize="12" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                       FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
