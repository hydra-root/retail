<UserControl x:Class="RetailBillingApp.Views.OpeningBalanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Opening Balances" Style="{StaticResource HeadingTextBlock}" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Refresh" Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButton}" />
            </StackPanel>
        </StackPanel>

        <!-- Main content: accounts grid (left) + side form and summary (right) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="2*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- Left: accounts -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <DataGrid ItemsSource="{Binding Accounts}"
                          SelectedItem="{Binding SelectedAccount}"
                          Style="{StaticResource DataGridStyle}"
                          AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Account" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Type" Binding="{Binding AccountType}" Width="120" />
                        <DataGridTextColumn Header="Opening Balance" Binding="{Binding OpeningBalance, StringFormat=C}" Width="150" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Right: wizard side form + summary -->
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,15">
                    <StackPanel Margin="15">
                        <TextBlock Text="Adjust Opening Balance" Style="{StaticResource SubHeadingTextBlock}" Margin="0,0,0,10" />
                        <TextBlock Text="Account:" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Accounts}"
                                  SelectedItem="{Binding SelectedAccount}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource BaseComboBox}" Margin="0,0,0,10" />
                        <TextBlock Text="New Opening Balance:" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewOpeningBalance, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F2}}"
                                 Style="{StaticResource BaseTextBox}" Margin="0,0,0,12" />
                        <Button Content="Save" Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" MinWidth="120" />
                        <TextBlock Text="Enter debits as positive for Assets/Expenses, credits as positive for Liabilities/Income/Equity so the trial balance stays balanced."
                                   FontSize="11" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Margin="15">
                        <TextBlock Text="Summary by Account Type" Style="{StaticResource SubHeadingTextBlock}" Margin="0,0,0,10" />
                        <DataGrid ItemsSource="{Binding SummaryRows}"
                                  Style="{StaticResource DataGridStyle}"
                                  AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Type" Binding="{Binding AccountType}" Width="*" />
                                <DataGridTextColumn Header="Total Opening" Binding="{Binding TotalOpeningBalance, StringFormat=C}" Width="140" />
                                <DataGridTextColumn Header="Accounts" Binding="{Binding AccountCount}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Style="{StaticResource SubHeadingTextBlock}" FontSize="11" Margin="0,10,0,0">
                            <TextBlock.Text>
                                <Binding Path="TotalOpeningBalance" StringFormat="Total Opening Balance: {0:C}" />
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Messages -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource SuccessBrush}"
                       FontSize="12" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                       FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
