<UserControl x:Class="RetailBillingApp.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="Inventory Management" Style="{StaticResource HeadingTextBlock}" />
            <Button Content="+ Add Product" Command="{Binding AddProductCommand}"
                    Style="{StaticResource SuccessButton}" HorizontalAlignment="Right" Margin="20,0,0,0" Width="120" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Product List -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,15">
                        <TextBlock Text="All Products" Style="{StaticResource SubHeadingTextBlock}" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}" Width="300" />
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding FilteredProducts}" SelectedItem="{Binding SelectedProduct}"
                              Style="{StaticResource DataGridStyle}" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" Width="100" />
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120" />
                            <DataGridTextColumn Header="Brand" Binding="{Binding Brand}" Width="100" />
                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit.Symbol}" Width="70" />
                            <DataGridTextColumn Header="Rate" Binding="{Binding Rate, StringFormat=C}" Width="100" />
                            <DataGridTextColumn Header="Stock" Binding="{Binding StockQty}" Width="80" />
                            <DataGridTemplateColumn Header="Status" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding IsLowStock, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Low Stock;OK'}"
                                                   Foreground="{Binding IsLowStock, Converter={StaticResource BoolToColorConverter}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Content="Delete Selected" Command="{Binding DeleteProductCommand}"
                            Style="{StaticResource DangerButton}" DockPanel.Dock="Bottom"
                            HorizontalAlignment="Right" Margin="0,15,0,0" Width="120" />
                </DockPanel>
            </Border>

            <!-- Add Product Form -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}" MaxWidth="400">
                <ScrollViewer>
                    <StackPanel Margin="20">
                        <TextBlock Text="Add New Product" Style="{StaticResource SubHeadingTextBlock}" />

                        <TextBlock Text="Product Name" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BaseTextBox}" />

                        <TextBlock Text="SKU" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewSku, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BaseTextBox}" />

                        <TextBlock Text="Barcode" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewBarcode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BaseTextBox}" />

                        <TextBlock Text="Category (from Categories &amp; Units)" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedCategory}"
                                  Style="{StaticResource BaseComboBox}" />

                        <TextBlock Text="Brand" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,4" />
                        <TextBox Text="{Binding NewBrand, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BaseTextBox}" />

                        <TextBlock Text="Unit" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Units}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedUnit}"
                                  Style="{StaticResource BaseComboBox}" />

                        <TextBlock Text="HSN Code" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewHsnCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BaseTextBox}" />

                        <TextBlock Text="Rate" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BaseTextBox}" />

                        <TextBlock Text="Tax %" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewTaxPercentage, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BaseTextBox}" />

                        <TextBlock Text="Stock Qty" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewStockQty, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BaseTextBox}" />

                        <TextBlock Text="Min Stock Qty" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewMinStockQty, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BaseTextBox}" />

                        <TextBlock Text="Batch" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewBatch, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BaseTextBox}" />

                        <TextBlock Text="Expiry Date" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <DatePicker SelectedDate="{Binding NewExpiryDate}" Style="{StaticResource BaseDatePicker}" />

                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                                   FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" />

                        <Button Content="Save Product" Command="{Binding AddProductCommand}"
                                Style="{StaticResource SuccessButton}" HorizontalAlignment="Stretch" Margin="0,15,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
