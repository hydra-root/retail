<UserControl x:Class="RetailBillingApp.Views.MessagingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1000">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Background="{StaticResource BackgroundBrush}" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Messaging Center" Style="{StaticResource HeadingTextBlock}" />
            </StackPanel>

            <!-- Card 1: Settings -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}" HorizontalAlignment="Left" MinWidth="700" Margin="0,0,0,15">
                <StackPanel Margin="15">
                    <TextBlock Text="Settings" Style="{StaticResource SubHeadingTextBlock}" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- INT-05: SMTP -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="SMTP Host:" VerticalAlignment="Center" Margin="0,0,8,5" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SmtpHost, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}" Margin="0,0,0,5" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="SMTP Port:" VerticalAlignment="Center" Margin="15,0,8,5" />
                        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding SmtpPort, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}" Margin="0,0,0,5" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="SMTP User:" VerticalAlignment="Center" Margin="0,0,8,5" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SmtpUser, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}" Margin="0,0,0,5" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="SMTP Password:" VerticalAlignment="Center" Margin="15,0,8,5" />
                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding SmtpPassword, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}" Margin="0,0,0,5" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="From Address:" VerticalAlignment="Center" Margin="0,0,8,5" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding FromAddress, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}" Margin="0,0,0,5" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="WhatsApp Country Code:" VerticalAlignment="Center" Margin="15,0,8,5" />
                        <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding DefaultWhatsAppCountryCode, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}" Margin="0,0,0,5" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <TextBlock Text="DLT SMS Sender:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding DltSmsSender, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}" MinWidth="120" />
                        <TextBlock Text="DLT Template Id:" VerticalAlignment="Center" Margin="15,0,8,0" />
                        <TextBox Text="{Binding DltTemplateId, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}" MinWidth="200" />
                    </StackPanel>
                    <TextBlock Text="Sending uses: SMS = registered DLT gateway (SMS stays a Draft until a provider is configured); WhatsApp = wa.me share link opened in your browser; Email = SMTP, or a mailto link when no host is set."
                               FontSize="11" Foreground="#888888" TextWrapping="Wrap" Margin="0,10,0,10" />
                    <Button Content="Save Settings" Command="{Binding SaveSettingsCommand}"
                            Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- Card 2: Compose & Send -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}" HorizontalAlignment="Left" MinWidth="700" Margin="0,0,0,15">
                <StackPanel Margin="15">
                    <TextBlock Text="Compose &amp; Send" Style="{StaticResource SubHeadingTextBlock}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
                        <TextBlock Text="Channel:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel}"
                                  Style="{StaticResource BaseComboBox}" MinWidth="130" />
                        <TextBlock Text="Recipient (phone / email):" VerticalAlignment="Center" Margin="15,0,8,0" />
                        <TextBox Text="{Binding Recipient, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}" MinWidth="220" />
                        <TextBlock Text="Invoice (Id or number):" VerticalAlignment="Center" Margin="15,0,8,0" />
                        <TextBox Text="{Binding ReferenceInvoice, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}" MinWidth="160" />
                        <Button Content="Load Invoice Message" Command="{Binding LoadInvoiceMessageCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="Message:" VerticalAlignment="Top" Margin="0,0,8,5" />
                    <TextBox Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource BaseTextBox}" MinWidth="660"
                             MinHeight="120" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
                    <Button Content="Send / Open" Command="{Binding SendOpenCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- Card 3: Message Log -->
            <Border Grid.Row="3" Style="{StaticResource CardBorder}">
                <Grid Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="260" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="15,15,15,5">
                        <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}"
                                Style="{StaticResource SecondaryButton}" />
                        <TextBlock Text="Message Log (latest 100)" Style="{StaticResource SubHeadingTextBlock}" />
                    </DockPanel>
                    <DataGrid Grid.Row="1" Margin="15,0,15,15" ItemsSource="{Binding LogRows}"
                              Style="{StaticResource DataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat=dd-MMM-yyyy HH:mm}" Width="140" />
                            <DataGridTextColumn Header="Channel" Binding="{Binding Channel}" Width="90" />
                            <DataGridTextColumn Header="Recipient" Binding="{Binding Recipient}" Width="160" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130" />
                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="300" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Messages -->
            <StackPanel Grid.Row="4" Margin="0,10,0,0">
                <TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource SuccessBrush}"
                           FontSize="12" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                           FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
