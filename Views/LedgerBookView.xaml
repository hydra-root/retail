<UserControl x:Class="RetailBillingApp.Views.LedgerBookView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="Day Book &amp; Ledger" Style="{StaticResource HeadingTextBlock}" />
        </StackPanel>

        <!-- Toolbar -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" Margin="15">
                <TextBlock Text="View:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox ItemsSource="{Binding ViewModes}" SelectedItem="{Binding ViewMode}"
                          Style="{StaticResource BaseComboBox}" MinWidth="120" />
                <TextBlock Text="From:" VerticalAlignment="Center" Margin="15,0,8,0" />
                <DatePicker SelectedDate="{Binding StartDate}" Style="{StaticResource BaseDatePicker}" />
                <TextBlock Text="To:" VerticalAlignment="Center" Margin="15,0,8,0" />
                <DatePicker SelectedDate="{Binding EndDate}" Style="{StaticResource BaseDatePicker}" />
                <TextBlock Text="Account:" VerticalAlignment="Center" Margin="15,0,8,0"
                           Visibility="{Binding IsLedgerMode, Converter={StaticResource BoolToVisibilityConverter}}" />
                <ComboBox ItemsSource="{Binding Accounts}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedAccount}"
                          Style="{StaticResource BaseComboBox}" MinWidth="160"
                          Visibility="{Binding IsLedgerMode, Converter={StaticResource BoolToVisibilityConverter}}" />
                <Button Content="Generate" Command="{Binding GenerateCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="15,0,0,0" />
                <Button Content="Export CSV" Command="{Binding ExportCsvCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" />
            </StackPanel>
        </Border>

        <!-- Summary (ledger only) -->
        <UniformGrid Grid.Row="2" Columns="2" Margin="0,0,0,15"
                     Visibility="{Binding IsLedgerMode, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="Opening Balance" Style="{StaticResource SubHeadingTextBlock}" FontSize="11" />
                    <TextBlock Text="{Binding LedgerReport.OpeningBalance, StringFormat={}{0:C}}" FontSize="20" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Padding="12">
                <StackPanel>
                    <TextBlock Text="Closing Balance" Style="{StaticResource SubHeadingTextBlock}" FontSize="11" />
                    <TextBlock Text="{Binding LedgerReport.ClosingBalance, StringFormat={}{0:C}}" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource SuccessBrush}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Rows -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SubHeadingTextBlock}" Margin="0,0,0,10"
                           Visibility="{Binding IsLedgerMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock.Text>
                        <Binding Path="LedgerReport.AccountName" StringFormat="Ledger: {0}" />
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SubHeadingTextBlock}" Margin="0,0,0,10"
                           Visibility="{Binding IsDayBookMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock.Text>
                        <Binding Path="DayBookTotal" StringFormat="Day Book — Total Debits: {0:C}" />
                    </TextBlock.Text>
                </TextBlock>

                <!-- Ledger grid -->
                <DataGrid ItemsSource="{Binding LedgerRows}" Style="{StaticResource DataGridStyle}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          Visibility="{Binding IsLedgerMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd-MMM-yyyy}" Width="100" />
                        <DataGridTextColumn Header="Source" Binding="{Binding ReferenceType}" Width="100" />
                        <DataGridTextColumn Header="Ref #" Binding="{Binding ReferenceId}" Width="90" />
                        <DataGridTextColumn Header="Narration" Binding="{Binding Narration}" Width="*" />
                        <DataGridTextColumn Header="Debit" Binding="{Binding Debit, StringFormat=C}" Width="120" />
                        <DataGridTextColumn Header="Credit" Binding="{Binding Credit, StringFormat=C}" Width="120" />
                        <DataGridTextColumn Header="Balance" Binding="{Binding RunningBalance, StringFormat=C}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Day book grid (flat journal lines) -->
                <DataGrid ItemsSource="{Binding DayBookFlatRows}" Style="{StaticResource DataGridStyle}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          Visibility="{Binding IsDayBookMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd-MMM-yyyy}" Width="100" />
                        <DataGridTextColumn Header="Source" Binding="{Binding ReferenceType}" Width="100" />
                        <DataGridTextColumn Header="Ref #" Binding="{Binding ReferenceId}" Width="90" />
                        <DataGridTextColumn Header="Account / Narration" Binding="{Binding Narration}" Width="*" />
                        <DataGridTextColumn Header="Debit" Binding="{Binding Debit, StringFormat=C}" Width="120" />
                        <DataGridTextColumn Header="Credit" Binding="{Binding Credit, StringFormat=C}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="4" Margin="0,10,0,0">
            <TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource SuccessBrush}"
                       FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
