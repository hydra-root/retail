<UserControl x:Class="RetailBillingApp.Views.StoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="Stores" Style="{StaticResource HeadingTextBlock}" />
            <Button Content="Refresh" Command="{Binding RefreshCommand}"
                    Style="{StaticResource SecondaryButton}" Margin="20,5,0,0" Width="90" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <!-- Store list + stock -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="All Stores (select to view stock)" Style="{StaticResource SubHeadingTextBlock}" />
                    </StackPanel>

                    <DataGrid DockPanel.Dock="Top" ItemsSource="{Binding Stores}" SelectedItem="{Binding SelectedStore}"
                              Style="{StaticResource DataGridStyle}" AutoGenerateColumns="False"
                              Height="260" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="140" />
                            <DataGridTextColumn Header="GSTIN" Binding="{Binding GSTIN}" Width="150" />
                            <DataGridTextColumn Header="Prefix" Binding="{Binding InvoicePrefix}" Width="70" />
                            <DataGridTextColumn Header="Active" Binding="{Binding IsActive}" Width="60" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock DockPanel.Dock="Top" Text="Stock at selected store (USR-03)"
                               Style="{StaticResource SubHeadingTextBlock}" Margin="0,15,0,6" />
                    <DataGrid DockPanel.Dock="Top" ItemsSource="{Binding StoreStock}"
                              Style="{StaticResource DataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*" />
                            <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" Width="120" />
                            <DataGridTextColumn Header="Qty On Hand" Binding="{Binding QuantityOnHand, StringFormat=N2}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Add / edit store form -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">

                        <TextBlock Text="New Store (USR-01)" Style="{StaticResource SubHeadingTextBlock}" Margin="5,0,0,10" />
                        <TextBox Text="{Binding NewStoreName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}" />
                        <TextBox Text="{Binding NewStoreLocation, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}" Margin="0,5,0,0" />
                        <TextBox Text="{Binding NewStoreContact, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}" Margin="0,5,0,0" />
                        <TextBox Text="{Binding NewStoreGstin, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}" Margin="0,5,0,0" />
                        <TextBox Text="{Binding NewStoreAddress, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}" Margin="0,5,0,0" />
                        <TextBox Text="{Binding NewStorePhone, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}" Margin="0,5,0,0" />
                        <TextBox Text="{Binding NewStoreEmail, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}" Margin="0,5,0,0" />
                        <TextBox Text="{Binding NewStoreInvoicePrefix, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}" Margin="0,5,0,0" />
                        <TextBox Text="{Binding NewStorePrinterName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}" Margin="0,5,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <CheckBox Content="Active" IsChecked="{Binding NewStoreIsActive}" />
                        </StackPanel>
                        <Button Content="Add Store" Command="{Binding AddStoreCommand}"
                                Style="{StaticResource SuccessButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Width="120" />

                        <Separator Margin="0,18,0,18" />

                        <TextBlock Text="Save Selected Store" Style="{StaticResource SubHeadingTextBlock}" Margin="5,0,0,10" />
                        <TextBox Text="{Binding SelectedStore.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}" />
                        <TextBox Text="{Binding SelectedStore.Location, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}" Margin="0,5,0,0" />
                        <TextBox Text="{Binding SelectedStore.Contact, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}" Margin="0,5,0,0" />
                        <TextBox Text="{Binding SelectedStore.GSTIN, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}" Margin="0,5,0,0" />
                        <TextBox Text="{Binding SelectedStore.Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}" Margin="0,5,0,0" />
                        <TextBox Text="{Binding SelectedStore.Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}" Margin="0,5,0,0" />
                        <TextBox Text="{Binding SelectedStore.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}" Margin="0,5,0,0" />
                        <TextBox Text="{Binding SelectedStore.InvoicePrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}" Margin="0,5,0,0" />
                        <TextBox Text="{Binding SelectedStore.PrinterName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}" Margin="0,5,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <CheckBox Content="Active" IsChecked="{Binding SelectedStore.IsActive, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Save Changes" Command="{Binding SaveStoreCommand}"
                                    Style="{StaticResource PrimaryButton}" Width="120" />
                            <Button Content="Delete Selected" Command="{Binding DeleteStoreCommand}"
                                    Style="{StaticResource DangerButton}" Width="120" Margin="10,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                   VerticalAlignment="Bottom" FontSize="12" Margin="0,0,0,5" />
    </Grid>
</UserControl>
