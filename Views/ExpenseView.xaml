<UserControl x:Class="RetailBillingApp.Views.ExpenseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="1100">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header + filter -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Expense Management" Style="{StaticResource HeadingTextBlock}" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <DatePicker SelectedDate="{Binding StartDate}" Style="{StaticResource BaseDatePicker}" />
                <TextBlock Text="To:" VerticalAlignment="Center" Margin="10,0,8,0" />
                <DatePicker SelectedDate="{Binding EndDate}" Style="{StaticResource BaseDatePicker}" />
                <Button Content="Filter" Command="{Binding FilterCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="15,0,0,0" MinWidth="90" />
                <Button Content="Export CSV" Command="{Binding ExportCsvCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- Add expense form -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" Margin="12">
                <TextBlock Text="Category:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox ItemsSource="{Binding NewCategories}" SelectedItem="{Binding NewCategory}"
                          Style="{StaticResource BaseComboBox}" MinWidth="130"
                          IsEditable="True"
                          ToolTip="Pick an existing category or type a new one" />
                <TextBlock Text="Amount:" VerticalAlignment="Center" Margin="12,0,8,0" />
                <TextBox Text="{Binding NewAmountText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource BaseTextBox}" MinWidth="90" />
                <TextBlock Text="Date:" VerticalAlignment="Center" Margin="12,0,8,0" />
                <DatePicker SelectedDate="{Binding NewExpenseDate}" Style="{StaticResource BaseDatePicker}" />
                <TextBlock Text="Mode:" VerticalAlignment="Center" Margin="12,0,8,0" />
                <ComboBox ItemsSource="{Binding PaymentModes}" SelectedItem="{Binding NewPaymentMode}"
                          Style="{StaticResource BaseComboBox}" MinWidth="120" />
                <TextBox Text="{Binding NewNotes, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource BaseTextBox}" MinWidth="150"
                         ToolTip="Optional notes" />
                <Button Content="Add Expense" Command="{Binding AddExpenseCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" MinWidth="110" />
                <Button Content="Delete Selected" Command="{Binding DeleteExpenseCommand}"
                        Style="{StaticResource DangerButton}" Margin="8,0,0,0" />
            </StackPanel>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Expense list -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SubHeadingTextBlock}" Margin="0,0,0,10"
                               Text="{Binding RangeTotal, StringFormat='Range Total: {0:C}'}" />
                    <DataGrid ItemsSource="{Binding Expenses}" Style="{StaticResource DataGridStyle}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              SelectedItem="{Binding SelectedExpense}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding ExpenseDate, StringFormat=dd-MMM-yyyy}" Width="100" />
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120" />
                            <DataGridTextColumn Header="Mode" Binding="{Binding PaymentMode}" Width="100" />
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=C}" Width="110" />
                            <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Category breakdown + totals -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Category Breakdown" Style="{StaticResource SubHeadingTextBlock}" Margin="0,0,0,10" />
                        <DataGrid ItemsSource="{Binding CategoryRows}" Style="{StaticResource DataGridStyle}"
                                  AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*" />
                                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C}" Width="100" />
                                <DataGridTextColumn Header="Share %" Binding="{Binding SharePercent, StringFormat={}{0}%}" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardBorder}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Monthly Totals" Style="{StaticResource SubHeadingTextBlock}" Margin="0,0,0,10" />
                        <DataGrid ItemsSource="{Binding MonthlyRows}" Style="{StaticResource DataGridStyle}"
                                  AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Month" Binding="{Binding Month}" Width="*" />
                                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C}" Width="100" />
                                <DataGridTextColumn Header="Entries" Binding="{Binding Count}" Width="70" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Messages -->
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource SuccessBrush}"
                       FontSize="12" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                       FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
