<UserControl x:Class="RetailBillingApp.Views.PurchaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="Purchases" Style="{StaticResource HeadingTextBlock}" />
            <Button Content="+ New Purchase" Command="{Binding CreatePurchaseCommand}"
                    Style="{StaticResource SuccessButton}" HorizontalAlignment="Right" Margin="20,0,0,0" Width="140" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- Purchase List -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,15">
                        <TextBlock Text="Purchase Register" Style="{StaticResource SubHeadingTextBlock}" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}" Width="300" />
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding FilteredPurchases}" SelectedItem="{Binding SelectedPurchase}"
                              Style="{StaticResource DataGridStyle}" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Purchase #" Binding="{Binding PurchaseNumber}" Width="*" />
                            <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="120" />
                            <DataGridTextColumn Header="Date" Binding="{Binding PurchaseDate, StringFormat=yyyy-MM-dd}" Width="100" />
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat=C}" Width="100" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Create Purchase Form -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                <ScrollViewer>
                    <StackPanel Margin="20">
                        <TextBlock Text="New Purchase" Style="{StaticResource SubHeadingTextBlock}" />

                        <TextBlock Text="Supplier Name" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewSupplierName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BaseTextBox}" />

                        <TextBlock Text="Payment Mode" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding PaymentModes}" SelectedItem="{Binding NewPaymentMode}"
                                  Style="{StaticResource BaseComboBox}" />

                        <TextBlock Text="Amount Paid" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,4" />
                        <TextBox Text="{Binding NewPaidAmount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BaseTextBox}" />

                        <!-- Items -->
                        <TextBlock Text="Items" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,20,0,10" />

                        <DataGrid ItemsSource="{Binding NewItems}" Style="{StaticResource DataGridStyle}" AutoGenerateColumns="False" Height="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*" />
                                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="60" />
                                <DataGridTextColumn Header="Rate" Binding="{Binding Rate, StringFormat=C}" Width="100" />
                                <DataGridTextColumn Header="Tax %" Binding="{Binding TaxPercentage}" Width="70" />
                                <DataGridTextColumn Header="Batch" Binding="{Binding Batch}" Width="80" />
                                <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryDate, StringFormat=yyyy-MM-dd}" Width="100" />
                                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C}" Width="100" />
                                <DataGridTemplateColumn Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Remove" Command="{Binding DataContext.RemoveItemFromPurchaseCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource DangerButton}" FontSize="11" Padding="6,2" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding NewProductName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BaseTextBox}" Grid.Column="0" Margin="0,0,4,0" />
                            <TextBox Text="{Binding NewProductQty, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BaseTextBox}" Grid.Column="1" Margin="0,0,4,0" />
                            <TextBox Text="{Binding NewProductRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BaseTextBox}" Grid.Column="2" Margin="0,0,4,0" />
                            <TextBox Text="{Binding NewProductTax, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BaseTextBox}" Grid.Column="3" Margin="0,0,4,0" />
                            <TextBox Text="{Binding NewBatch, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BaseTextBox}" Grid.Column="4" Margin="0,0,4,0" />
                            <DatePicker SelectedDate="{Binding NewExpiryDate}" Style="{StaticResource BaseDatePicker}" Grid.Column="5" Margin="0,0,0,0" />
                            <Button Content="Add" Command="{Binding AddItemToPurchaseCommand}" Grid.RowSpan="2" Width="80" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
                        </Grid>

                        <Border Background="{StaticResource SurfaceBrush}" Padding="15" CornerRadius="6" Margin="0,20,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Subtotal" Grid.Row="0" Grid.Column="0" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding NewSubTotal, StringFormat=C}" Grid.Row="0" Grid.Column="1" FontWeight="SemiBold" />

                                <TextBlock Text="Tax" Grid.Row="1" Grid.Column="0" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding NewTaxAmount, StringFormat=C}" Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" />

                                <TextBlock Text="TOTAL" Grid.Row="2" Grid.Column="0" FontWeight="Bold" FontSize="16" Foreground="{StaticResource PrimaryBrush}" />
                                <TextBlock Text="{Binding NewTotalAmount, StringFormat=C}" Grid.Row="2" Grid.Column="1" FontWeight="Bold" FontSize="16" Foreground="{StaticResource PrimaryBrush}" />
                            </Grid>
                        </Border>

                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                                   FontSize="12" Margin="0,15,0,0" TextWrapping="Wrap" />

                        <Button Content="Create Purchase" Command="{Binding CreatePurchaseCommand}"
                                Style="{StaticResource SuccessButton}" HorizontalAlignment="Stretch" Margin="0,15,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
