<UserControl x:Class="RetailBillingApp.Views.StockTakeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Stock Take (Physical Verification)" Style="{StaticResource HeadingTextBlock}" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Refresh" Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButton}" />
                <TextBlock Text="{Binding SelectedTake.StockTakeNumber, StringFormat=Selected: {0}}"
                           VerticalAlignment="Center" Margin="20,0,0,0"
                           FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <!-- Left: stocktake list + create form -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="15,15,15,8">
                        <TextBlock Text="Stock Takes" Style="{StaticResource SubHeadingTextBlock}" />
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding StockTakes}"
                              SelectedItem="{Binding SelectedTake}"
                              Style="{StaticResource DataGridStyle}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Number" Binding="{Binding StockTakeNumber}" Width="*" />
                            <DataGridTextColumn Header="Date" Binding="{Binding StockTakeDate, StringFormat=dd-MMM-yyyy}" Width="90" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel DockPanel.Dock="Bottom" Margin="15,12,15,15">
                        <TextBlock Text="New Stock Take" Style="{StaticResource SubHeadingTextBlock}" Margin="0,0,0,8" />
                        <TextBlock Text="Notes" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewStockTakeNotes, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}" />
                        <TextBlock Text="Store Id (blank = all stores)" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,4" />
                        <TextBox Text="{Binding NewStockTakeStoreId, TargetNullValue=''}"
                                 Style="{StaticResource BaseTextBox}" />
                        <Button Content="Create Stock Take" Command="{Binding CreateStockTakeCommand}"
                                Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Margin="0,12,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Middle: stocktake sheet -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="15,0,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Margin="0,0,0,12" Padding="0">
                        <!-- Variance summary cards -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                                <StackPanel Margin="10">
                                    <TextBlock Text="Items Counted" Style="{StaticResource SubHeadingTextBlock}" FontSize="11" />
                                    <TextBlock Text="{Binding ItemsCounted}" FontSize="24" FontWeight="Bold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                                <StackPanel Margin="10">
                                    <TextBlock Text="Variance Qty" Style="{StaticResource SubHeadingTextBlock}" FontSize="11" />
                                    <TextBlock Text="{Binding VarianceQty, StringFormat={}{0:+0;-0;0}}"
                                               FontSize="24" FontWeight="Bold"
                                               Foreground="{StaticResource SuccessBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                                <StackPanel Margin="10">
                                    <TextBlock Text="Variance Value" Style="{StaticResource SubHeadingTextBlock}" FontSize="11" />
                                    <TextBlock Text="{Binding VarianceValueCard, StringFormat={}{0:C}}"
                                               FontSize="24" FontWeight="Bold"
                                               Foreground="{StaticResource SuccessBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Button DockPanel.Dock="Bottom" Content="Complete Stock Take (Post Variances)"
                            Command="{Binding CompleteStockTakeCommand}"
                            Style="{StaticResource SuccessButton}" HorizontalAlignment="Stretch" Margin="0,12,0,0" />

                    <DataGrid ItemsSource="{Binding CurrentItems}"
                              SelectedItem="{Binding SelectedItem}"
                              Style="{StaticResource DataGridStyle}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*" />
                            <DataGridTextColumn Header="System Qty" Binding="{Binding SystemQty}" Width="100" />
                            <DataGridTextColumn Header="Counted Qty"
                                                Binding="{Binding CountedQty, TargetNullValue='—'}" Width="100" />
                            <DataGridTextColumn Header="Variance"
                                                Binding="{Binding Variance, StringFormat={}{0:+0;-0;0}}" Width="90" />
                            <DataGridTextColumn Header="Counted?"
                                                Binding="{Binding Saved, Converter={StaticResource BoolToTextConverter}, ConverterParameter=Yes;No}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Right: count entry form -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="15,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <TextBlock Text="Record Count" Style="{StaticResource SubHeadingTextBlock}" />

                        <TextBlock Text="Product" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4" />
                        <ComboBox ItemsSource="{Binding CurrentItems}"
                                  SelectedItem="{Binding SelectedItem}"
                                  DisplayMemberPath="ProductName"
                                  Style="{StaticResource BaseComboBox}" />

                        <TextBlock Text="{Binding SelectedItem.SystemQty, StringFormat='System Qty: {0}'}"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,10,0,0" />

                        <TextBlock Text="Counted Qty" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4" />
                        <TextBox Text="{Binding CountedQtyEntry, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}" />

                        <Button Content="Record Count" Command="{Binding RecordCountCommand}"
                                Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Margin="0,15,0,0" />

                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                                   FontSize="12" Margin="0,15,0,0" TextWrapping="Wrap" />

                        <TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource SuccessBrush}"
                                   FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Messages -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource SuccessBrush}"
                       FontSize="12" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                       FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
