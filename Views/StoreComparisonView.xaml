<UserControl x:Class="RetailBillingApp.Views.StoreComparisonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header + toolbar -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Multi-Store Comparison" Style="{StaticResource HeadingTextBlock}" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <DatePicker SelectedDate="{Binding StartDate}" Style="{StaticResource BaseDatePicker}" />
                <TextBlock Text="To:" VerticalAlignment="Center" Margin="10,0,8,0" />
                <DatePicker SelectedDate="{Binding EndDate}" Style="{StaticResource BaseDatePicker}" />
                <Button Content="Generate" Command="{Binding GenerateCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="15,0,0,0" MinWidth="95" />
                <Button Content="Export CSV" Command="{Binding ExportCsvCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- Summary cards -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,15">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="Total Sales (excl. tax)" Style="{StaticResource SubHeadingTextBlock}" FontSize="11" />
                    <TextBlock Text="{Binding TotalSales, StringFormat={}{0:C}}" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource SuccessBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="Total Gross Profit" Style="{StaticResource SubHeadingTextBlock}" FontSize="11" />
                    <TextBlock Text="{Binding TotalGrossProfit, StringFormat={}{0:C}}" FontSize="20" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Padding="12">
                <StackPanel>
                    <TextBlock Text="🏆 Best Store" Style="{StaticResource SubHeadingTextBlock}" FontSize="11" />
                    <TextBlock Text="{Binding BestStore}" FontSize="16" FontWeight="Bold"
                               ToolTip="Highest sales in the period (share of total)" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Comparison grid -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding RangeSummary}"
                           Style="{StaticResource SubHeadingTextBlock}" Margin="0,0,0,10" />
                <DataGrid ItemsSource="{Binding Rows}" Style="{StaticResource DataGridStyle}"
                          AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Rank" Binding="{Binding Rank}" Width="60" />
                        <DataGridTextColumn Header="Store" Binding="{Binding StoreName}" Width="*" />
                        <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="*" />
                        <DataGridTextColumn Header="Invoices" Binding="{Binding InvoiceCount}" Width="80" />
                        <DataGridTextColumn Header="Sales" Binding="{Binding Sales, StringFormat=C}" Width="130" />
                        <DataGridTextColumn Header="Sales Share" Binding="{Binding SalesSharePercent, StringFormat={}{0}%}" Width="100" />
                        <DataGridTextColumn Header="COGS" Binding="{Binding COGS, StringFormat=C}" Width="130" />
                        <DataGridTextColumn Header="Gross Profit" Binding="{Binding GrossProfit, StringFormat=C}" Width="130" />
                        <DataGridTextColumn Header="Margin %" Binding="{Binding MarginPercent, StringFormat={}{0}%}" Width="90" />
                        <DataGridTextColumn Header="Outstanding" Binding="{Binding Outstanding, StringFormat=C}" Width="130" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Messages -->
        <StackPanel Grid.Row="4" Margin="0,10,0,0">
            <TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource SuccessBrush}"
                       FontSize="12" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                       FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
