<UserControl x:Class="RetailBillingApp.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="Users" Style="{StaticResource HeadingTextBlock}" />
            <Button Content="Refresh" Command="{Binding RefreshCommand}"
                    Style="{StaticResource SecondaryButton}" Margin="20,5,0,0" Width="90" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- User list + actions -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="All Users" Style="{StaticResource SubHeadingTextBlock}" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,15,0,0">
                        <Button Content="Activate / Deactivate" Command="{Binding ToggleActiveCommand}"
                                Style="{StaticResource SecondaryButton}" Width="150" />
                        <Button Content="Unlock User" Command="{Binding UnlockUserCommand}"
                                Style="{StaticResource SuccessButton}" Width="120" Margin="10,0,0,0" />
                        <Button Content="Reset Password" Command="{Binding ResetPasswordCommand}"
                                Style="{StaticResource PrimaryButton}" Width="130" Margin="10,0,0,0" />
                        <Button Content="Delete" Command="{Binding DeleteUserCommand}"
                                Style="{StaticResource DangerButton}" Width="90" Margin="10,0,0,0" />
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                              Style="{StaticResource DataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="140" />
                            <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="100" />
                            <DataGridTextColumn Header="Store" Binding="{Binding Store.Name, FallbackValue=''}" Width="120" />
                            <DataGridTemplateColumn Header="Active" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding IsActive, StringFormat=Yes}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Failed Attempts" Binding="{Binding FailedLoginAttempts}" Width="60" />
                            <DataGridTextColumn Header="Locked Until" Binding="{Binding LockedUntil, StringFormat=g, TargetNullValue=''}" Width="140" />
                            <DataGridTextColumn Header="Last Login" Binding="{Binding LastLoginAt, StringFormat=g, TargetNullValue=''}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Add user form -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}" VerticalAlignment="Top">
                <StackPanel Margin="15">
                    <TextBlock Text="Add User (USR-04)" Style="{StaticResource SubHeadingTextBlock}" Margin="0,0,0,10" />

                    <TextBlock Text="Username" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource BaseTextBox}" />

                    <TextBlock Text="Password (min 6 chars)" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,4" />
                    <PasswordBox x:Name="NewPasswordBox" Style="{StaticResource BasePasswordBox}" />

                    <TextBlock Text="Role" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,4" />
                    <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding NewUserRole}"
                              DisplayMemberPath="Name" Style="{StaticResource BaseComboBox}" />

                    <TextBlock Text="Store (optional)" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,4" />
                    <ComboBox ItemsSource="{Binding Stores}" SelectedItem="{Binding NewUserStore}"
                              DisplayMemberPath="Name" Style="{StaticResource BaseComboBox}" />

                    <CheckBox Content="Active" IsChecked="{Binding NewUserIsActive}" Margin="0,10,0,0" />

                    <Button Content="Add User" Command="{Binding AddUserCommand}"
                            Style="{StaticResource SuccessButton}" HorizontalAlignment="Left" Width="120" Margin="0,12,0,0" Click="AddPassword_Click" />

                    <Separator Margin="0,18,0,18" />
                    <TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource SuccessBrush}" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
