<UserControl x:Class="RetailBillingApp.Views.InvoicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="Invoicing &amp; GST" Style="{StaticResource HeadingTextBlock}" />
            <Button Content="Print Preview" Command="{Binding OpenPrintPreviewCommand}"
                    Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Margin="20,0,0,0" Width="140" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- Invoice List -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,15">
                        <TextBlock Text="Invoice Register" Style="{StaticResource SubHeadingTextBlock}" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}" Width="300" HorizontalAlignment="Left" />

                        <!-- INV-13: advanced filters -->
                        <WrapPanel Margin="0,10,0,0">
                            <TextBlock Text="From" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,4"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <DatePicker SelectedDate="{Binding FilterFrom}" Style="{StaticResource BaseDatePicker}"
                                        Width="110" Margin="0,0,8,4" />
                            <TextBlock Text="To" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,4"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <DatePicker SelectedDate="{Binding FilterTo}" Style="{StaticResource BaseDatePicker}"
                                        Width="110" Margin="0,0,8,4" />
                            <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding FilterStatus}"
                                      Style="{StaticResource BaseComboBox}" Width="95" Margin="0,0,6,4" />
                            <ComboBox ItemsSource="{Binding TypeFilters}" SelectedItem="{Binding FilterType}"
                                      Style="{StaticResource BaseComboBox}" Width="115" Margin="0,0,6,4" />
                            <ComboBox ItemsSource="{Binding PaymentModeFilters}" SelectedItem="{Binding FilterPaymentMode}"
                                      Style="{StaticResource BaseComboBox}" Width="90" Margin="0,0,6,4" />
                            <TextBox Text="{Binding FilterMinAmount, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource BaseTextBox}" Width="70" Margin="0,0,4,4" />
                            <TextBox Text="{Binding FilterMaxAmount, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource BaseTextBox}" Width="70" Margin="0,0,6,4" />
                            <CheckBox Content="Dues only" IsChecked="{Binding FilterOutstandingOnly}"
                                      VerticalContentAlignment="Center" Margin="0,0,8,4" />
                            <Button Content="Clear filters" Command="{Binding ResetFiltersCommand}"
                                    Style="{StaticResource SecondaryButton}" FontSize="11" Padding="8,2" Margin="0,0,0,4" />
                        </WrapPanel>

                        <TextBlock FontSize="11" Margin="0,2,0,0" Foreground="{StaticResource TextSecondaryBrush}">
                            <Run Text="Showing " /><Run Text="{Binding RegisterCount, Mode=OneWay}" /><Run Text=" invoice(s)" />
                        </TextBlock>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding FilteredInvoices}" SelectedItem="{Binding SelectedInvoice}"
                              Style="{StaticResource DataGridStyle}" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Invoice #" Binding="{Binding InvoiceNumber}" Width="*" />
                            <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="120" />
                            <DataGridTextColumn Header="GSTIN" Binding="{Binding CustomerGSTIN}" Width="100" />
                            <DataGridTextColumn Header="Date" Binding="{Binding InvoiceDate, StringFormat=yyyy-MM-dd}" Width="100" />
                            <DataGridTextColumn Header="CGST" Binding="{Binding CGST, StringFormat=C}" Width="80" />
                            <DataGridTextColumn Header="SGST" Binding="{Binding SGST, StringFormat=C}" Width="80" />
                            <DataGridTextColumn Header="IGST" Binding="{Binding IGST, StringFormat=C}" Width="80" />
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat=C}" Width="100" />
                            <DataGridTextColumn Header="Written Off" Binding="{Binding WriteOffAmount, StringFormat=C}" Width="90" />
                            <DataGridTextColumn Header="Type" Binding="{Binding TypeLabel}" Width="110" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Create Invoice Form -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                <ScrollViewer>
                    <StackPanel Margin="20">
                        <TextBlock Text="Create Invoice" Style="{StaticResource SubHeadingTextBlock}" />

                        <TextBlock Text="Customer Name" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}"
                                  DisplayMemberPath="Name" IsEditable="True"
                                  Text="{Binding NewCustomerName, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource BaseComboBox}" />

                        <TextBlock Text="Customer GSTIN (Optional)" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewCustomerGSTIN, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BaseTextBox}" />

                        <TextBlock Text="Place of Supply (State)" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,4" />
                        <TextBox Text="{Binding NewPlaceOfSupply, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BaseTextBox}" />

                        <TextBlock Text="Payment Mode" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,4" />
                        <ComboBox ItemsSource="{Binding PaymentModes}" SelectedItem="{Binding NewPaymentMode}"
                                  Style="{StaticResource BaseComboBox}" />

                        <TextBlock Text="Amount Paid" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,4" />
                        <TextBox Text="{Binding NewPaidAmount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BaseTextBox}" />

                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <CheckBox Content="Bill of Supply (Non-GST, no tax)" IsChecked="{Binding NewIsBillOfSupply}"
                                      VerticalContentAlignment="Center" />
                        </StackPanel>
                        <!-- INV-04: invoice-level tax mode (new lines follow it; button flips existing lines) -->
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <CheckBox Content="Draft is Tax Inclusive (rates include GST)" IsChecked="{Binding DraftTaxInclusive}"
                                      VerticalContentAlignment="Center" />
                            <Button Content="Apply Tax Mode to All Lines" Command="{Binding ApplyTaxModeToAllCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="15,0,0,0" FontSize="11" Padding="8,3" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <CheckBox Content="Create as Estimate (no stock impact until converted)" IsChecked="{Binding NewIsEstimate}"
                                      VerticalContentAlignment="Center" />
                        </StackPanel>

                        <!-- PAY-05: manager override for credit-limit blocks (INV-10 reuses it for edit/delete rules) -->
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="Manager Override (credit limit, edits, deletes)" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBox Text="{Binding OverrideUsername, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource BaseTextBox}" Margin="0,4,0,0" ToolTip="Admin username (optional)" />
                            <PasswordBox x:Name="OverridePasswordBox" Margin="0,5,0,0"
                                         PasswordChanged="OverridePasswordBox_PasswordChanged" ToolTip="Admin password (optional)" />
                            <!-- INV-10: delete button with period-lock + payment rules -->
                            <Button Content="Delete Selected Invoice" Command="{Binding DeleteInvoiceCommand}"
                                    Style="{StaticResource DangerButton}" Margin="0,10,0,0" HorizontalAlignment="Stretch"
                                    ToolTip="Estimates delete freely; live invoices need an admin override; collected or locked-period invoices are refused" />
                        </StackPanel>

                        <!-- Items -->
                        <TextBlock Text="Items" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,20,0,10" />

                        <DataGrid ItemsSource="{Binding NewItems}" Style="{StaticResource DataGridStyle}" AutoGenerateColumns="False" Height="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*" />
                                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="50" />
                                <DataGridTextColumn Header="Rate" Binding="{Binding Rate, StringFormat=C}" Width="80" />
                                <DataGridTextColumn Header="Tax %" Binding="{Binding TaxPercentage}" Width="60" />
                                <DataGridTextColumn Header="CGST" Binding="{Binding CGST, StringFormat=C}" Width="70" />
                                <DataGridTextColumn Header="SGST" Binding="{Binding SGST, StringFormat=C}" Width="70" />
                                <DataGridTextColumn Header="IGST" Binding="{Binding IGST, StringFormat=C}" Width="70" />
                                <DataGridTextColumn Header="Cess" Binding="{Binding Cess, StringFormat=C}" Width="60" />
                                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C}" Width="80" />
                                <DataGridTemplateColumn Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Remove" Command="{Binding DataContext.RemoveItemFromInvoiceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource DangerButton}" FontSize="11" Padding="6,2" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
                                      DisplayMemberPath="Name" Style="{StaticResource BaseComboBox}"
                                      Grid.Column="0" Margin="0,0,4,0" />
                            <TextBox Text="{Binding NewProductQty, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BaseTextBox}" Grid.Column="1" Margin="0,0,4,0" />
                            <TextBox Text="{Binding NewProductRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BaseTextBox}" Grid.Column="2" Margin="0,0,4,0" />
                            <TextBox Text="{Binding NewProductTax, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BaseTextBox}" Grid.Column="3" Margin="0,0,4,0" />
                            <TextBox Text="{Binding NewProductCessRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BaseTextBox}" Grid.Column="4" Margin="0,0,4,0" />
                            <CheckBox Content="Tax Inclusive (this line)" IsChecked="{Binding NewProductTaxInclusive, Mode=TwoWay}" Grid.Column="5" Margin="4,0,0,0" VerticalAlignment="Center" />
                            <Button Content="Add" Command="{Binding AddItemToInvoiceCommand}" Grid.RowSpan="2" Width="80" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
                        </Grid>

                        <!-- PAY-06: where the last line's rate came from -->
                        <TextBlock Text="{Binding PriceSource}" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />

                        <Border Background="{StaticResource SurfaceBrush}" Padding="15" CornerRadius="6" Margin="0,20,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Subtotal" Grid.Row="0" Grid.Column="0" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding NewSubTotal, StringFormat=C}" Grid.Row="0" Grid.Column="1" FontWeight="SemiBold" />

                                <TextBlock Text="CGST" Grid.Row="1" Grid.Column="0" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding NewCGST, StringFormat=C}" Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" />

                                <TextBlock Text="SGST" Grid.Row="2" Grid.Column="0" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding NewSGST, StringFormat=C}" Grid.Row="2" Grid.Column="1" FontWeight="SemiBold" />

                                <TextBlock Text="IGST" Grid.Row="3" Grid.Column="0" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding NewIGST, StringFormat=C}" Grid.Row="3" Grid.Column="1" FontWeight="SemiBold" />

                                <TextBlock Text="Cess" Grid.Row="4" Grid.Column="0" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding NewCess, StringFormat=C}" Grid.Row="4" Grid.Column="1" FontWeight="SemiBold" />

                                <TextBlock Text="TOTAL" Grid.Row="5" Grid.Column="0" FontWeight="Bold" FontSize="16" Foreground="{StaticResource PrimaryBrush}" />
                                <TextBlock Text="{Binding NewTotalAmount, StringFormat=C}" Grid.Row="5" Grid.Column="1" FontWeight="Bold" FontSize="16" Foreground="{StaticResource PrimaryBrush}" />
                            </Grid>
                        </Border>

                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                                   FontSize="12" Margin="0,15,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding WarningMessage}" Foreground="Orange"
                                   FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource SuccessBrush}"
                                   FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" />

                        <Button Content="Create Invoice / Estimate" Command="{Binding CreateInvoiceCommand}"
                                Style="{StaticResource SuccessButton}" HorizontalAlignment="Stretch" Margin="0,15,0,0" />

                        <Button Content="Convert Selected Estimate → Invoice" Command="{Binding ConvertEstimateToInvoiceCommand}"
                                Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Margin="0,10,0,0" />

                        <Button Content="Write Off Remaining (Selected)" Command="{Binding WriteOffRemainingCommand}"
                                Style="{StaticResource DangerButton}" HorizontalAlignment="Stretch" Margin="0,10,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
