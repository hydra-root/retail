<UserControl x:Class="RetailBillingApp.Views.PrivacyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Privacy &amp; Compliance" Style="{StaticResource HeadingTextBlock}" />
            <TextBlock Text="Audit retention purging, retention preview and GDPR-style data export."
                       VerticalAlignment="Center" Margin="0,6,0,0" />
        </StackPanel>

        <!-- Cards row -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">

            <!-- Retention card -->
            <Border Style="{StaticResource CardBorder}" MinWidth="560" Margin="0,0,15,0">
                <StackPanel Margin="15">
                    <TextBlock Text="Data Retention" Style="{StaticResource SubHeadingTextBlock}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Older than (days):" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding RetentionDays, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}" MinWidth="80" />
                        <Button Content="Preview" Command="{Binding PreviewRetentionCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" />
                        <Button Content="Purge Audit Trail" Command="{Binding PurgeAuditCommand}"
                                Style="{StaticResource DangerButton}" Margin="15,0,0,0" />
                        <Button Content="Purge Activity Logs" Command="{Binding PurgeLogsCommand}"
                                Style="{StaticResource DangerButton}" Margin="10,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="Audit records past cutoff:" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding AuditPreviewCount}" VerticalAlignment="Center" Margin="0,0,25,0" />
                        <TextBlock Text="Activity logs past cutoff:" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding LogsPreviewCount}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Data export card -->
            <Border Style="{StaticResource CardBorder}" MinWidth="360">
                <StackPanel Margin="15">
                    <TextBlock Text="Data Export (GDPR Request)" Style="{StaticResource SubHeadingTextBlock}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Customer ID:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding ExportCustomerId, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}" MinWidth="80" />
                        <Button Content="Export CSV" Command="{Binding ExportCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="Exports profile, invoices and payments as CSV on the Desktop."
                               Margin="0,12,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Results grid -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}">
            <DataGrid ItemsSource="{Binding Results}" Style="{StaticResource DataGridStyle}"
                      AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="180" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                    <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Messages -->
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource SuccessBrush}"
                       FontSize="12" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                       FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
