<UserControl x:Class="RetailBillingApp.Views.CreditAnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="Credit Analysis" Style="{StaticResource HeadingTextBlock}" />
        </StackPanel>

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource BaseTextBox}" MinWidth="220" />
            <Button Content="Refresh" Command="{Binding RefreshCommand}"
                    Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" />
            <Button Content="Export CSV" Command="{Binding ExportCsvCommand}"
                    Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" />
        </StackPanel>

        <!-- Totals -->
        <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,15">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="Total Credit Used" Style="{StaticResource SubHeadingTextBlock}" FontSize="11" />
                    <TextBlock Text="{Binding TotalUsed, StringFormat={}{0:C}}" FontSize="20" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="Total Overdue" Style="{StaticResource SubHeadingTextBlock}" FontSize="11" />
                    <TextBlock Text="{Binding TotalOverdue, StringFormat={}{0:C}}" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource ErrorBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Padding="12">
                <StackPanel>
                    <TextBlock Text="Customers at Risk" Style="{StaticResource SubHeadingTextBlock}" FontSize="11" />
                    <TextBlock Text="{Binding CustomersAtRisk}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Credit grid -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}">
            <DataGrid ItemsSource="{Binding FilteredRows}" Style="{StaticResource DataGridStyle}"
                      AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="160" />
                    <DataGridTextColumn Header="Mobile" Binding="{Binding Mobile}" Width="110" />
                    <DataGridTextColumn Header="Limit" Binding="{Binding CreditLimit, StringFormat=C}" Width="110" />
                    <DataGridTextColumn Header="Used" Binding="{Binding Used, StringFormat=C}" Width="110" />
                    <DataGridTextColumn Header="Available" Binding="{Binding Available, StringFormat=C}" Width="110" />
                    <DataGridTextColumn Header="Utilization" Binding="{Binding UtilizationPct, StringFormat={}{0:F1}%}" Width="100" />
                    <DataGridTextColumn Header="Pending" Binding="{Binding PendingInvoices}" Width="80" />
                    <DataGridTextColumn Header="Overdue" Binding="{Binding OverdueAmount, StringFormat=C}" Width="120" />
                    <DataGridTextColumn Header="Avg Days To Pay" Binding="{Binding AvgDaysToPay}" Width="110" />
                    <DataGridTextColumn Header="Risk" Binding="{Binding RiskFlag}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="4" Text="{Binding SuccessMessage}" Foreground="{StaticResource SuccessBrush}"
                   FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" />
    </Grid>
</UserControl>
