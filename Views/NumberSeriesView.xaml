<UserControl x:Class="RetailBillingApp.Views.NumberSeriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="1100">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header + actions -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Number Series" Style="{StaticResource HeadingTextBlock}" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Check Gaps (Gap-Free Audit)" Command="{Binding CheckGapsCommand}"
                        Style="{StaticResource SecondaryButton}" MinWidth="190"
                        ToolTip="Compares issued document numbers against each series' expected sequence" />
                <TextBox Text="{Binding RollOverFinancialYearText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource BaseTextBox}" MinWidth="100" Margin="15,0,0,0"
                         ToolTip="New financial year, e.g. 2027-28" />
                <Button Content="Roll Over To New FY" Command="{Binding RollOverYearCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" MinWidth="150"
                        ToolTip="Clones every repeating series into the new FY, restarting at its start number" />
                <Button Content="Save Edits" Command="{Binding SaveEditsCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="15,0,0,0" MinWidth="100"
                        ToolTip="Persists prefix/suffix edits made directly in the grid" />
            </StackPanel>
            <TextBlock Text="Edit Prefix/Suffix directly in the grid, then click Save Edits. Next Number shows what will be issued next."
                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- Series grid -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <Button Content="Delete Selected" Command="{Binding DeleteSeriesCommand}"
                            Style="{StaticResource DangerButton}" DockPanel.Dock="Bottom"
                            HorizontalAlignment="Right" Margin="0,15,0,0" Width="120" />
                    <DataGrid x:Name="SeriesGrid" ItemsSource="{Binding Series}" SelectedItem="{Binding SelectedSeries}"
                              Style="{StaticResource DataGridStyle}" AutoGenerateColumns="False"
                              CellEditEnding="SeriesGrid_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150" IsReadOnly="True" />
                            <DataGridTextColumn Header="Prefix" Binding="{Binding Prefix}" Width="80" />
                            <DataGridTextColumn Header="Suffix" Binding="{Binding Suffix}" Width="80" />
                            <DataGridTextColumn Header="Next Number" Binding="{Binding NextNumber}" Width="130" IsReadOnly="True" />
                            <DataGridTextColumn Header="Current No." Binding="{Binding CurrentNumber}" Width="90" IsReadOnly="True" />
                            <DataGridTextColumn Header="FY" Binding="{Binding FinancialYear}" Width="90" IsReadOnly="True" />
                            <DataGridTextColumn Header="Doc Type" Binding="{Binding DocType}" Width="90" IsReadOnly="True" />
                            <DataGridTextColumn Header="Resets" Binding="{Binding ResetEachYear}" Width="60" IsReadOnly="True" />
                            <DataGridTemplateColumn Width="70" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Reset" Command="{Binding DataContext.ResetSeriesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource PrimaryButton}" FontSize="11" Padding="6,2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Add Series Form -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="10,0,0,0">
                <ScrollViewer>
                    <StackPanel Margin="20">
                        <TextBlock Text="Add Number Series" Style="{StaticResource SubHeadingTextBlock}" />

                        <TextBlock Text="Series Name" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BaseTextBox}" />

                        <TextBlock Text="Prefix" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,4" />
                        <TextBox Text="{Binding NewPrefix, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BaseTextBox}" />

                        <TextBlock Text="Suffix (optional)" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,4" />
                        <TextBox Text="{Binding NewSuffix, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BaseTextBox}" />

                        <TextBlock Text="Start Number" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,4" />
                        <TextBox Text="{Binding NewStartNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BaseTextBox}" />

                        <TextBlock Text="Financial Year" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,4" />
                        <ComboBox ItemsSource="{Binding FinancialYears}" SelectedItem="{Binding NewFinancialYear}"
                                  Style="{StaticResource BaseComboBox}" />

                        <TextBlock Text="Document Type" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,4" />
                        <ComboBox ItemsSource="{Binding DocTypes}" SelectedItem="{Binding NewDocType}"
                                  Style="{StaticResource BaseComboBox}" />

                        <CheckBox Content="Reset each financial year" IsChecked="{Binding NewResetEachYear}" Margin="0,12,0,0" />

                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                                   FontSize="12" Margin="0,15,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource SuccessBrush}"
                                   FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />

                        <Button Content="Add Series" Command="{Binding AddSeriesCommand}"
                                Style="{StaticResource SuccessButton}" HorizontalAlignment="Stretch" Margin="0,15,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Gap audit results -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,15,0,0"
                Visibility="{Binding HasGapRows, Converter={StaticResource BoolToVisibilityConverter}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Gap Audit (issued numbers vs expected sequence)"
                           Style="{StaticResource SubHeadingTextBlock}" Margin="0,0,0,10" />
                <DataGrid ItemsSource="{Binding GapRows}" Style="{StaticResource DataGridStyle}"
                          AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Doc Type" Binding="{Binding DocType}" Width="90" />
                        <DataGridTextColumn Header="Series" Binding="{Binding SeriesName}" Width="140" />
                        <DataGridTextColumn Header="FY" Binding="{Binding FinancialYear}" Width="90" />
                        <DataGridTextColumn Header="Format" Binding="{Binding Prefix, StringFormat={}{0}####}" Width="110" />
                        <DataGridTextColumn Header="Issued" Binding="{Binding Issued}" Width="70" />
                        <DataGridTextColumn Header="First" Binding="{Binding FirstNumber}" Width="70" />
                        <DataGridTextColumn Header="Last" Binding="{Binding LastNumber}" Width="70" />
                        <DataGridTextColumn Header="Missing" Binding="{Binding Missing}" Width="*" />
                        <DataGridTextColumn Header="Duplicates" Binding="{Binding Duplicates}" Width="120" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Error bar for gap/rollover operations -->
        <TextBlock Grid.Row="3" Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                   FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" />
    </Grid>
</UserControl>
