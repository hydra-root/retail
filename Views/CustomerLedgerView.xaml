<UserControl x:Class="RetailBillingApp.Views.CustomerLedgerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Customer Ledger &amp; Statement" Style="{StaticResource HeadingTextBlock}" />
        </StackPanel>

        <!-- Toolbar -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" Margin="12">
                <TextBlock Text="Customer:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox ItemsSource="{Binding Customers}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedCustomer}"
                          Style="{StaticResource BaseComboBox}" MinWidth="200" />
                <TextBlock Text="From:" VerticalAlignment="Center" Margin="15,0,8,0" />
                <DatePicker SelectedDate="{Binding StartDate}" Style="{StaticResource BaseDatePicker}" />
                <TextBlock Text="To:" VerticalAlignment="Center" Margin="10,0,8,0" />
                <DatePicker SelectedDate="{Binding EndDate}" Style="{StaticResource BaseDatePicker}" />
                <Button Content="Generate" Command="{Binding GenerateCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="15,0,0,0" MinWidth="100" />
                <Button Content="Print Statement" Command="{Binding PrintStatementCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" MinWidth="120" />
            </StackPanel>
        </Border>

        <!-- Balance cards -->
        <UniformGrid Grid.Row="2" Columns="2" Margin="0,0,0,15">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="Opening Balance" Style="{StaticResource SubHeadingTextBlock}" FontSize="11" />
                    <TextBlock Text="{Binding LedgerRow.OpeningBalance, StringFormat={}{0:C}}" FontSize="20" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Padding="12">
                <StackPanel>
                    <TextBlock Text="Closing Balance (Receivable)" Style="{StaticResource SubHeadingTextBlock}" FontSize="11" />
                    <TextBlock Text="{Binding LedgerRow.ClosingBalance, StringFormat={}{0:C}}" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource ErrorBrush}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Ledger grid -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SubHeadingTextBlock}" Margin="0,0,0,10">
                    <TextBlock.Text>
                        <Binding Path="LedgerRow.CustomerName" StringFormat="Ledger: {0}" />
                    </TextBlock.Text>
                </TextBlock>
                <DataGrid ItemsSource="{Binding Rows}" Style="{StaticResource DataGridStyle}"
                          AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd-MMM-yyyy}" Width="100" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100" />
                        <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="130" />
                        <DataGridTextColumn Header="Narration" Binding="{Binding Narration}" Width="*" />
                        <DataGridTextColumn Header="Debit" Binding="{Binding Debit, StringFormat=C}" Width="120" />
                        <DataGridTextColumn Header="Credit" Binding="{Binding Credit, StringFormat=C}" Width="120" />
                        <DataGridTextColumn Header="Balance" Binding="{Binding RunningBalance, StringFormat=C}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Messages -->
        <StackPanel Grid.Row="4" Margin="0,10,0,0">
            <TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource SuccessBrush}"
                       FontSize="12" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                       FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
