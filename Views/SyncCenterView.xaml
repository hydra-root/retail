<UserControl x:Class="RetailBillingApp.Views.SyncCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="860" d:DesignWidth="1320">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Sync Centre — Connection, Health and History" Style="{StaticResource HeadingTextBlock}" />
            <TextBlock Text="Local-first sync: the till keeps billing into its own queue and this screen controls the link to central HQ — which endpoint runs, whether it answers, how deep the queue is and what every recent run did"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" />
                <ColumnDefinition Width="*" MinWidth="520" />
            </Grid.ColumnDefinitions>

            <!-- Status cards -->
            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Connection -->
                    <Border Style="{StaticResource CardBorder}" VerticalAlignment="Top">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Connection" Style="{StaticResource SubHeadingTextBlock}" VerticalAlignment="Center" />
                                <Button Content="Refresh" Command="{Binding RefreshCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                            </Grid>

                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                <TextBlock Text="{Binding ConnectionBadgeText}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                            </Border>

                            <TextBlock Text="{Binding HealthText}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />

                            <TextBlock Text="{Binding TransportName}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />

                            <Border Background="{StaticResource SuccessBrush}" CornerRadius="4" Padding="10" Margin="0,10,0,0"
                                    Visibility="{Binding IsConnectionGood, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="The endpoint answered. A Sync now run will hand the queue to it."
                                           TextWrapping="Wrap" FontSize="11" Foreground="White" />
                            </Border>

                            <Border Background="{StaticResource ErrorBrush}" CornerRadius="4" Padding="10" Margin="0,10,0,0"
                                    Visibility="{Binding IsConnectionBad, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="No batch was sent and no change lost an attempt while the link is down. Read the reason below and fix that first."
                                           TextWrapping="Wrap" FontSize="11" Foreground="White" />
                            </Border>

                            <TextBlock Text="{Binding ProbeDetail}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" />

                            <TextBlock Text="{Binding TransportReason}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" />

                            <Border Background="{StaticResource WarningBrush}" CornerRadius="4" Padding="10" Margin="0,12,0,0">
                                <TextBlock Text="Live vs simulated: switching on the live HQ endpoint replaces the built-in simulated transport for every run. Until a run succeeds, this till has only rehearsed against its own stand-in."
                                           TextWrapping="Wrap" FontSize="11" Foreground="White" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Queue depth -->
                    <Border Style="{StaticResource CardBorder}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SubHeadingTextBlock}" Margin="0,0,0,8">
                                <Run Text="Local Queue Depth (" /><Run Text="{Binding TotalCount, Mode=OneWay}" /><Run Text=" rows)" />
                            </TextBlock>

                            <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}">
                                <Run Text="Waiting: " FontWeight="SemiBold" /><Run Text="{Binding PendingCount, Mode=OneWay}" />
                                <Run Text="   Queued: " /><Run Text="{Binding QueuedCount, Mode=OneWay}" />
                                <Run Text="   Delivered: " /><Run Text="{Binding SyncedCount, Mode=OneWay}" />
                                <Run Text="   Discarded: " /><Run Text="{Binding DiscardedCount, Mode=OneWay}" />
                            </TextBlock>

                            <TextBlock Text="{Binding QueueDepthText}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" />

                            <TextBlock Text="{Binding OldestPendingText}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />

                            <TextBlock Text="{Binding StatusBreakdownText}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0" />

                            <TextBlock Text="{Binding EntityBreakdownText}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />

                            <TextBlock Text="{Binding QueueDisciplineText}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0" />

                            <TextBlock Text="Row by row work (read a payload, discard one change, purge delivered rows) lives on the Offline / Sync Queue screen in the sidebar."
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Last run -->
                    <Border Style="{StaticResource CardBorder}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Last Run" Style="{StaticResource SubHeadingTextBlock}" Margin="0,0,0,8" />

                            <TextBlock Text="{Binding LastRunSummaryText}" FontSize="12" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" />

                            <TextBlock Text="{Binding LastRunDetailText}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />

                            <TextBlock Text="{Binding LastResultText}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" />

                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,10,0,0"
                                    Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding EmptyStateText}" TextWrapping="Wrap" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="Sync now" Command="{Binding RunNowCommand}"
                                        Style="{StaticResource PrimaryButton}" MinWidth="110"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                                <Button Content="Retry failed" Command="{Binding RetryFailedCommand}"
                                        Style="{StaticResource SuccessButton}" MinWidth="110" Margin="8,0,0,0"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Failures -->
                    <Border Style="{StaticResource CardBorder}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SubHeadingTextBlock}" Margin="0,0,0,8">
                                <Run Text="Failures (" /><Run Text="{Binding FailedCount, Mode=OneWay}" /><Run Text=" on hold)" />
                            </TextBlock>

                            <Border Background="{StaticResource ErrorBrush}" CornerRadius="4" Padding="10"
                                    Visibility="{Binding FailedCount, Converter={StaticResource IntToVisibilityConverter}}">
                                <TextBlock Text="{Binding FailuresText}" TextWrapping="Wrap" FontSize="11" Foreground="White" />
                            </Border>

                            <TextBlock Text="{Binding FailuresText}" TextWrapping="Wrap" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Visibility="{Binding HasNoFailures, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Settings + history -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="220" />
                </Grid.RowDefinitions>

                <!-- Connection settings -->
                <Border Grid.Row="0" Style="{StaticResource CardBorder}" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="HQ Connection Settings" Style="{StaticResource SubHeadingTextBlock}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Save connection" Command="{Binding SaveSettingsCommand}"
                                        Click="SaveSettings_Click"
                                        Style="{StaticResource PrimaryButton}" MinWidth="130"
                                        IsEnabled="{Binding IsDirty}" />
                                <Button Content="Test connection" Command="{Binding TestConnectionCommand}"
                                        Style="{StaticResource SecondaryButton}" MinWidth="130" Margin="8,0,0,0"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="Use the live HQ endpoint (this replaces the simulated transport)"
                                  IsChecked="{Binding IsEnabled}" Margin="4,0,4,10" />

                        <TextBlock Text="HQ sync address — the API root only, always https:// and never a key in it"
                                   FontSize="12" Margin="4,0,4,4" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}"
                                 IsEnabled="{Binding LiveFieldsEnabled}"
                                 ToolTip="For example https://hq.example.com/api/v1 — the till probes it/health and POSTs batches to it/changes" />

                        <TextBlock Text="Device name this till signs batches with" FontSize="12" Margin="4,0,4,4"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Text="{Binding DeviceIdentifier, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}" MaxLength="100"
                                 IsEnabled="{Binding LiveFieldsEnabled}"
                                 ToolTip="Sent as the X-Device-Id header so central HQ can tell the tills apart" />

                        <TextBlock Text="API key" FontSize="12" Margin="4,0,4,4"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding ApiKeyStatusText}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="4,0,4,4" />
                        <!-- Deliberately a PasswordBox read in code-behind: Password is not a bindable
                             property, and the stored key is never written back into this box. -->
                        <PasswordBox x:Name="ApiKeyBox" Style="{StaticResource BasePasswordBox}" MaxLength="200"
                                     PasswordChanged="ApiKeyBox_PasswordChanged"
                                     IsEnabled="{Binding LiveFieldsEnabled}"
                                     ToolTip="Paste the key HQ issued. It is stored for the transport and shown masked everywhere else." />

                        <CheckBox Content="Require TLS (refuse a plain http:// address)" IsChecked="{Binding UseTlsOnly}"
                                  Margin="4,4,4,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Changes per call" FontSize="12" Margin="4,0,4,4"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <ComboBox ItemsSource="{Binding BatchSizeOptions}"
                                          SelectedItem="{Binding SelectedBatchSizeLabel}"
                                          Style="{StaticResource BaseComboBox}"
                                          IsEnabled="{Binding LiveFieldsEnabled}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Wait before giving up" FontSize="12" Margin="4,0,4,4"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <ComboBox ItemsSource="{Binding TimeoutOptions}"
                                          SelectedItem="{Binding SelectedTimeoutLabel}"
                                          Style="{StaticResource BaseComboBox}"
                                          IsEnabled="{Binding LiveFieldsEnabled}" />
                            </StackPanel>
                        </Grid>

                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="12" Margin="4,12,4,0">
                            <StackPanel>
                                <TextBlock Text="Effective configuration" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding ConfigurationText}" TextWrapping="Wrap" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="4,10,4,0" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                            <Run Text="Last change: " /><Run Text="{Binding LastChangedByText, Mode=OneWay}" />
                        </TextBlock>

                        <Border Background="{StaticResource SuccessBrush}" CornerRadius="4" Padding="10" Margin="4,10,4,0"
                                Visibility="{Binding TestSucceededVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding TestResultText}" TextWrapping="Wrap" FontSize="11" Foreground="White" />
                        </Border>

                        <Border Background="{StaticResource ErrorBrush}" CornerRadius="4" Padding="10" Margin="4,10,4,0"
                                Visibility="{Binding TestFailedVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{Binding TestResultText}" TextWrapping="Wrap" FontSize="11" Foreground="White" />
                                <TextBlock Text="Nothing was sent and no change lost an attempt while the link is refused."
                                           TextWrapping="Wrap" FontSize="11" Foreground="White" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Run history -->
                <Border Grid.Row="1" Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource SubHeadingTextBlock}" VerticalAlignment="Center">
                                <Run Text="Sync History (" /><Run Text="{Binding HistoryRowCount, Mode=OneWay}" /><Run Text=" runs, newest first)" />
                            </TextBlock>
                            <Button Content="Clear history" Command="{Binding ClearHistoryCommand}"
                                    Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                        </Grid>

                        <TextBlock Grid.Row="1" Text="Only the last 200 runs are kept; older runs are trimmed automatically. Nothing here holds a credential."
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,8" />

                        <Grid Grid.Row="2">
                            <DataGrid ItemsSource="{Binding History}"
                                      SelectedItem="{Binding SelectedRun, Mode=TwoWay}"
                                      Style="{StaticResource DataGridStyle}"
                                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                      Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibilityConverter}}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Started" Binding="{Binding StartedText}" Width="150" />
                                    <DataGridTextColumn Header="Trigger" Binding="{Binding Trigger}" Width="110" />
                                    <DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="100" />
                                    <DataGridTextColumn Header="Accepted" Binding="{Binding CountText}" Width="110" />
                                    <DataGridTextColumn Header="Rejected" Binding="{Binding RejectedCount}" Width="80" />
                                    <DataGridTextColumn Header="Newly failed" Binding="{Binding FailedCount}" Width="110" />
                                    <DataGridTextColumn Header="Left queued" Binding="{Binding RemainingCount}" Width="110" />
                                    <DataGridTextColumn Header="Took" Binding="{Binding DurationText}" Width="80" />
                                    <DataGridTextColumn Header="Transport" Binding="{Binding TransportName}" Width="200" />
                                    <DataGridTextColumn Header="Device" Binding="{Binding DeviceLabel}" Width="130" />
                                    <DataGridTemplateColumn Header="Detail" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" FontSize="11"
                                                           Margin="4,2" VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           ToolTip="{Binding OutcomeHint}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Text="No run has been recorded from this till yet. Press Sync now — even a run that sends nothing is written here, so you can see why."
                                       FontSize="12" TextWrapping="Wrap" VerticalAlignment="Top"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Visibility="{Binding HasNoHistory, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Busy + messages -->
        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock Text="Working — the till stays usable while HQ answers." FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
            <TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource SuccessBrush}"
                       FontSize="12" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                       FontSize="12" TextWrapping="Wrap" />
            <TextBlock Text="{Binding WarningsText}" Foreground="{StaticResource WarningBrush}"
                       FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
