<UserControl x:Class="RetailBillingApp.Views.ItemProfitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header + toolbar -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Item-wise Profit" Style="{StaticResource HeadingTextBlock}" />
            <WrapPanel Margin="0,10,0,0">
                <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <DatePicker SelectedDate="{Binding StartDate}" Style="{StaticResource BaseDatePicker}" />
                <TextBlock Text="To:" VerticalAlignment="Center" Margin="15,0,8,0" />
                <DatePicker SelectedDate="{Binding EndDate}" Style="{StaticResource BaseDatePicker}" />
                <TextBlock Text="Mode:" VerticalAlignment="Center" Margin="15,0,8,0" />
                <ComboBox ItemsSource="{Binding TopModes}" SelectedItem="{Binding TopMode}"
                          Style="{StaticResource BaseComboBox}" MinWidth="150" />
                <TextBlock Text="Count:" VerticalAlignment="Center" Margin="15,0,8,0" />
                <TextBox Text="{Binding Count, UpdateSourceTrigger=PropertyChanged, TargetNullValue=25}"
                         Style="{StaticResource BaseTextBox}" MinWidth="60" />
                <Button Content="Generate" Command="{Binding GenerateCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="15,0,0,0" />
            </WrapPanel>
        </StackPanel>

        <!-- Summary cards -->
        <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,15">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="Total Profit" Style="{StaticResource SubHeadingTextBlock}" FontSize="11" />
                    <TextBlock Text="{Binding TotalProfit, StringFormat={}{0:C}}" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource SuccessBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Padding="12">
                <StackPanel>
                    <TextBlock Text="Average Margin (%)" Style="{StaticResource SubHeadingTextBlock}" FontSize="11" />
                    <TextBlock Text="{Binding AvgMarginPercent, StringFormat={}{0:N1}%}" FontSize="24" FontWeight="Bold" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Grid -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}">
            <DataGrid ItemsSource="{Binding Rows}" Style="{StaticResource DataGridStyle}"
                      AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*" />
                    <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" Width="110" />
                    <DataGridTextColumn Header="Qty" Binding="{Binding QuantitySold}" Width="80" />
                    <DataGridTextColumn Header="Invoices" Binding="{Binding InvoiceCount}" Width="90" />
                    <DataGridTextColumn Header="Sales" Binding="{Binding Sales, StringFormat=C}" Width="120" />
                    <DataGridTextColumn Header="COGS" Binding="{Binding COGS, StringFormat=C}" Width="120" />
                    <DataGridTextColumn Header="Profit" Binding="{Binding Profit, StringFormat=C}" Width="120" />
                    <DataGridTextColumn Header="Margin %" Binding="{Binding ProfitMarginPercent, StringFormat={}{0:N2}}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Messages -->
        <StackPanel Grid.Row="4" Margin="0,10,0,0">
            <TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource SuccessBrush}"
                       FontSize="12" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                       FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
