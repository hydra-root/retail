<UserControl x:Class="RetailBillingApp.Views.CreditSalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1360">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Credit Sales" Style="{StaticResource HeadingTextBlock}" Margin="0,0,0,4" />
            <TextBlock Text="{Binding PolicySummary}" TextWrapping="Wrap" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>

        <!-- Toolbar -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,6,0" />
            <DatePicker SelectedDate="{Binding StartDate}" Style="{StaticResource BaseDatePicker}" Margin="0,0,12,0" />
            <TextBlock Text="To" VerticalAlignment="Center" Margin="0,0,6,0" />
            <DatePicker SelectedDate="{Binding EndDate}" Style="{StaticResource BaseDatePicker}" Margin="0,0,16,0" />

            <TextBlock Text="Ageing" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox ItemsSource="{Binding BucketFilters}" SelectedItem="{Binding BucketFilter}"
                      Style="{StaticResource BaseComboBox}" MinWidth="140" Margin="0,0,16,0" />

            <TextBlock Text="Search" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource BaseTextBox}" MinWidth="200" Margin="0,0,16,0" />

            <CheckBox Content="Overdue only" IsChecked="{Binding OverdueOnly}"
                      VerticalAlignment="Center" Margin="0,0,12,0" />

            <Button Content="Refresh" Command="{Binding RefreshCommand}"
                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
            <Button Content="Export CSV" Command="{Binding ExportCsvCommand}"
                    Style="{StaticResource SecondaryButton}" />
        </WrapPanel>

        <!-- KPI cards -->
        <Grid Grid.Row="2" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="6">
                <StackPanel>
                    <TextBlock Text="Total Credit Sales" Style="{StaticResource SubHeadingTextBlock}" FontSize="11" />
                    <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}">
                        <TextBlock.Text>
                            <Binding Path="TotalCreditSales" StringFormat="₹{0:N2}" />
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="6">
                <StackPanel>
                    <TextBlock Text="Outstanding" Style="{StaticResource SubHeadingTextBlock}" FontSize="11" />
                    <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource WarningBrush}">
                        <TextBlock.Text>
                            <Binding Path="TotalOutstanding" StringFormat="₹{0:N2}" />
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="6">
                <StackPanel>
                    <TextBlock Text="Overdue" Style="{StaticResource SubHeadingTextBlock}" FontSize="11" />
                    <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}">
                        <TextBlock.Text>
                            <Binding Path="TotalOverdue" StringFormat="₹{0:N2}" />
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource CardBorder}" Margin="6">
                <StackPanel>
                    <TextBlock Text="Blocked Customers" Style="{StaticResource SubHeadingTextBlock}" FontSize="11" />
                    <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}"
                               Text="{Binding BlockedCustomerCount}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Ledger + settle/limit panel -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="640" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- Credit-invoice grid -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                          Style="{StaticResource DataGridStyle}"
                          AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Settle" Width="72">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Settle"
                                            Command="{Binding DataContext.SelectCustomerForRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource SecondaryButton}" FontSize="11" Padding="6,2" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="140" />
                        <DataGridTextColumn Header="Date" Binding="{Binding InvoiceDate, StringFormat=dd-MMM-yyyy}" Width="100" />
                        <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*" MinWidth="150" />
                        <DataGridTextColumn Header="GSTIN" Binding="{Binding Gstin}" Width="120" />
                        <DataGridTextColumn Header="Due Date" Binding="{Binding DueDateText}" Width="100" />
                        <DataGridTextColumn Header="Due status" Binding="{Binding DaysPastDueText}" Width="130" />
                        <DataGridTextColumn Header="Bucket" Binding="{Binding Bucket}" Width="110" />
                        <DataGridTextColumn Header="Value" Binding="{Binding InvoiceValue, StringFormat=₹{0:N2}}" Width="110" />
                        <DataGridTextColumn Header="Collected" Binding="{Binding Collected, StringFormat=₹{0:N2}}" Width="110" />
                        <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat=₹{0:N2}}" Width="110" />
                        <DataGridTextColumn Header="Status" Binding="{Binding OverdueLabel}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Settle oldest-first + read-only limit panel -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" VerticalAlignment="Stretch">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Settle Oldest First" Style="{StaticResource SubHeadingTextBlock}" Margin="0,0,0,10" />

                    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedCustomerName}" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Credit limit" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock FontSize="13" FontWeight="SemiBold">
                                        <TextBlock.Text>
                                            <Binding Path="SelectedSummary.CreditLimit" StringFormat="₹{0:N2}" FallbackValue="—" />
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Outstanding" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}">
                                        <TextBlock.Text>
                                            <Binding Path="SelectedSummary.Outstanding" StringFormat="₹{0:N2}" FallbackValue="—" />
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Headroom" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}">
                                        <TextBlock.Text>
                                            <Binding Path="SelectedSummary.Headroom" StringFormat="₹{0:N2}" FallbackValue="—" />
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                            <TextBlock Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                                       Text="Customer is within credit limit."
                                       Foreground="{StaticResource TextSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSummary.IsBlocked}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                                       Text="{Binding SelectedSummary.BlockedReason}"
                                       Foreground="{StaticResource ErrorBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSummary.IsBlocked}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Settle controls -->
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="Settlement amount" FontSize="12" Margin="0,0,0,2" />
                        <TextBox Text="{Binding SettleAmount, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}" Margin="0,0,0,6" />
                        <TextBlock Text="Payment mode" FontSize="12" Margin="0,0,0,2" />
                        <ComboBox ItemsSource="{Binding PaymentModes}" SelectedItem="{Binding SettlePaymentMode}"
                                  Style="{StaticResource BaseComboBox}" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Preview FIFO" Command="{Binding PreviewSettleCommand}"
                                    Style="{StaticResource SecondaryButton}" MinWidth="120"
                                    IsEnabled="{Binding CanSettle}" />
                            <Button Content="Settle" Command="{Binding SettleCommand}"
                                    Style="{StaticResource SuccessButton}" MinWidth="110" Margin="8,0,0,0"
                                    IsEnabled="{Binding CanSettle}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- FIFO allocation preview -->
                    <DataGrid Grid.Row="3" ItemsSource="{Binding SettlePreview}" Margin="0,12,0,0"
                              Style="{StaticResource DataGridStyle}"
                              AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="*" />
                            <DataGridTextColumn Header="Date" Binding="{Binding InvoiceDateText}" Width="80" />
                            <DataGridTextColumn Header="Before" Binding="{Binding BalanceBefore, StringFormat=₹{0:N2}}" Width="80" />
                            <DataGridTextColumn Header="Applied" Binding="{Binding Applied, StringFormat=₹{0:N2}}" Width="80" />
                            <DataGridTextColumn Header="After" Binding="{Binding BalanceAfter, StringFormat=₹{0:N2}}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Messages -->
        <StackPanel Grid.Row="4" Margin="0,10,0,0">
            <TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource SuccessBrush}"
                       FontSize="12" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                       FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
