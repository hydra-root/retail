<UserControl x:Class="RetailBillingApp.Views.StorePricingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Store Pricing (USR-03)" Style="{StaticResource HeadingTextBlock}" />
        </StackPanel>

        <!-- Toolbar: store + buyer scope + reload -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Store" Style="{StaticResource SubHeadingTextBlock}" FontSize="12" />
                <ComboBox ItemsSource="{Binding Stores}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedStore}" Style="{StaticResource BaseComboBox}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Customer (optional — empty = all)" Style="{StaticResource SubHeadingTextBlock}" FontSize="12" />
                <ComboBox ItemsSource="{Binding Customers}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedCustomer}" Style="{StaticResource BaseComboBox}" />
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="Customer Group (optional)" Style="{StaticResource SubHeadingTextBlock}" FontSize="12" />
                <TextBox Text="{Binding SelectedCustomerGroup, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                         Style="{StaticResource BaseTextBox}" />
            </StackPanel>
            <StackPanel Grid.Column="6" VerticalAlignment="Bottom">
                <Button Content="Reload Grid" Command="{Binding GridCommand}"
                        Style="{StaticResource SecondaryButton}" />
            </StackPanel>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding CountText}"
                               Style="{StaticResource SubHeadingTextBlock}" Margin="0,0,0,10" />
                    <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                              Style="{StaticResource DataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*" />
                            <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" Width="110" />
                            <DataGridTextColumn Header="Master Rate" Binding="{Binding MasterRate, StringFormat=N2}" Width="100" />
                            <DataGridTextColumn Header="Global Net" Binding="{Binding GlobalNet, StringFormat=N2}" Width="100" />
                            <DataGridTextColumn Header="Store Rate" Binding="{Binding StoreRate, StringFormat=N2}" Width="100" />
                            <DataGridTextColumn Header="Store Disc %" Binding="{Binding StoreDiscountPct, StringFormat=N2}" Width="95" />
                            <DataGridTextColumn Header="Billed Rate" Binding="{Binding BilledRate, StringFormat=N2}" Width="100" />
                            <DataGridTextColumn Header="Delta" Binding="{Binding Delta, StringFormat=N2}" Width="90" />
                            <DataGridTextColumn Header="Override" Binding="{Binding HasOverride}" Width="90" />
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="180" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Edit override card -->
                <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Edit override" Style="{StaticResource SubHeadingTextBlock}" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding SelectedRow.ProductName, TargetNullValue='Select a product above'}"
                                   FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Store Rate" Style="{StaticResource SubHeadingTextBlock}" FontSize="12" />
                                <TextBox Text="{Binding EditRate, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource BaseTextBox}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Discount %" Style="{StaticResource SubHeadingTextBlock}" FontSize="12" />
                                <TextBox Text="{Binding EditDiscountPct, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource BaseTextBox}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Notes (optional)" Style="{StaticResource SubHeadingTextBlock}" FontSize="12" />
                        <TextBox Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Save Override" Command="{Binding SaveOverrideCommand}"
                                    Style="{StaticResource SuccessButton}" />
                            <Button Content="Clear Override" Command="{Binding ClearOverrideCommand}"
                                    Style="{StaticResource DangerButton}" Margin="10,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Store-wide card -->
                <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Store-wide" Style="{StaticResource SubHeadingTextBlock}" Margin="0,0,0,10" />
                        <TextBlock Text="Copy the currently-resolvable global rates into this store as store defaults, or clear every override in the chosen scope (customer &gt; group &gt; everyone)."
                                   FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Copy Global Rates" Command="{Binding CopyGlobalCommand}"
                                    Style="{StaticResource SecondaryButton}" />
                            <Button Content="Clear All Overrides For Scope" Command="{Binding ClearStoreCommand}"
                                    Style="{StaticResource DangerButton}" Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding CountText}" Margin="0,10,0,0" FontSize="12"
                                   TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Messages -->
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                       FontSize="12" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource SuccessBrush}"
                       FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
