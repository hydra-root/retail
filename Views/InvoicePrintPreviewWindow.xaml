<Window x:Class="RetailBillingApp.Views.InvoicePrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Invoice Print Preview"
        Height="820" Width="980"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title + status -->
        <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource SubHeadingTextBlock}" Margin="0,0,0,12" />

        <!-- Toolbar: layout, copies, printer, commands -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
            <WrapPanel>
                <TextBlock Text="Layout:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox ItemsSource="{Binding Layouts}" SelectedItem="{Binding SelectedLayout}"
                          Style="{StaticResource BaseComboBox}" MinWidth="130" />

                <TextBlock Text="Copies:" VerticalAlignment="Center" Margin="16,0,6,0" />
                <TextBox Text="{Binding Copies, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource BaseTextBox}" Width="48" />

                <TextBlock Text="Printer:" VerticalAlignment="Center" Margin="16,0,6,0" />
                <TextBox Text="{Binding PrinterName, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource BaseTextBox}" Width="160"
                         ToolTip="Name of the printer to select in the print dialog (optional)" />

                <Button Content="Refresh" Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="16,0,0,0" />
                <Button Content="Print" Command="{Binding PrintCommand}"
                        Style="{StaticResource SuccessButton}" Margin="6,0,0,0" />
                <Button Content="Save as text" Command="{Binding SaveAsTextFileCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" />
                <Button Content="Close" Command="{Binding CloseCommand}"
                        Style="{StaticResource DangerButton}" Margin="6,0,0,0" />
            </WrapPanel>
        </Border>

        <!-- Preview area: the "page" the user sees before printing -->
        <Border Grid.Row="2" Background="#DDE2E8" CornerRadius="6" Padding="16">
            <Grid>
                <!-- A4 / Half Sheet: paginated FlowDocument viewer -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Top"
                        Background="White" BorderBrush="#9AA5B1" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsThermal}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <FlowDocumentScrollViewer Document="{Binding PreviewDocument}"
                                              HorizontalAlignment="Center"
                                              VerticalScrollBarVisibility="Auto"
                                              MinWidth="520" MinHeight="400" MaxWidth="820" />
                </Border>

                <!-- Thermal 80mm: narrow monospace paper strip -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Top" Width="322"
                        Background="White" BorderBrush="#9AA5B1" BorderThickness="1"
                        ToolTip="Thermal 80mm receipt — 42 columns">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsThermal}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="600" Padding="6">
                        <TextBox Text="{Binding ThermalText, Mode=OneWay}" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap"
                                 AcceptsReturn="True" BorderThickness="0" Background="Transparent"
                                 Foreground="#111111" IsTabStop="False" />
                    </ScrollViewer>
                </Border>

                <!-- Nothing loaded yet / invoice missing -->
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"
                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                           MaxWidth="520" TextAlignment="Center"
                           Text="No preview available — the invoice could not be loaded.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Document}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Success / error line -->
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource SuccessBrush}"
                       FontSize="12" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                       FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
