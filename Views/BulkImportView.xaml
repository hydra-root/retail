<UserControl x:Class="RetailBillingApp.Views.BulkImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header + toolbar -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Bulk Import / Export" Style="{StaticResource HeadingTextBlock}" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Import:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox ItemsSource="{Binding EntityType}" SelectedItem="{Binding SelectedEntityType}"
                          Style="{StaticResource BaseComboBox}" MinWidth="130" />
                <Button Content="Browse &amp; Preview" Command="{Binding PreviewCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="15,0,0,0" MinWidth="130" />
                <Button Content="Commit Import" Command="{Binding CommitCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" MinWidth="120" />
                <Button Content="Download Template" Command="{Binding ExportTemplateCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="25,0,0,0" MinWidth="150" />
                <Button Content="Export All" Command="{Binding ExportAllCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" MinWidth="110" />
            </StackPanel>
            <TextBlock Text="{Binding SelectedFile, StringFormat=File: {0}}"
                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- Summary cards -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <Border Style="{StaticResource CardBorder}" MinWidth="220" Margin="0,0,15,0">
                <StackPanel Margin="15">
                    <TextBlock Text="Rows to be Imported" Style="{StaticResource SubHeadingTextBlock}" FontSize="11" />
                    <TextBlock Text="{Binding TotalImported, StringFormat={}{0:N0}}" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource SuccessBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" MinWidth="220">
                <StackPanel Margin="15">
                    <TextBlock Text="Rows Failed Validation" Style="{StaticResource SubHeadingTextBlock}" FontSize="11" />
                    <TextBlock Text="{Binding TotalFailed, StringFormat={}{0:N0}}" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource ErrorBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Preview grid -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}">
            <DataGrid ItemsSource="{Binding PreviewRows}" Style="{StaticResource DataGridStyle}"
                      AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Row" Binding="{Binding Row}" Width="60" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="70" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*" />
                    <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="260" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Messages -->
        <StackPanel Grid.Row="4" Margin="0,10,0,0">
            <TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource SuccessBrush}"
                       FontSize="12" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                       FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
