<UserControl x:Class="RetailBillingApp.Views.RoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="Roles &amp; Permissions" Style="{StaticResource HeadingTextBlock}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- Role List -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,15">
                        <TextBlock Text="Roles" Style="{StaticResource SubHeadingTextBlock}" />
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}"
                              Style="{StaticResource DataGridStyle}" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="150" />
                            <DataGridTextColumn Header="System" Binding="{Binding IsSystem, StringFormat={}{0}}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,15,0,0">
                        <TextBlock Text="Add Role" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
                        <TextBox Text="{Binding NewRoleName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}" />
                        <TextBox Text="{Binding NewRoleDescription, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}" />
                        <Button Content="Add Role" Command="{Binding AddRoleCommand}"
                                Style="{StaticResource SuccessButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Width="120" />
                        <Button Content="Delete Selected" Command="{Binding DeleteRoleCommand}"
                                Style="{StaticResource DangerButton}" HorizontalAlignment="Left" Margin="10,10,0,0" Width="120" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Role Permissions -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,15">
                        <TextBlock Text="{Binding SelectedRole.Name, TargetNullValue='Select a role', StringFormat='Permissions for {0}'}" Style="{StaticResource SubHeadingTextBlock}" />
                    </StackPanel>

                    <StackPanel Margin="20">
                        <TextBlock Text="Available Permissions" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding AvailablePermissions}" Style="{StaticResource DataGridStyle}" AutoGenerateColumns="False" Height="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Button Content="Assign Selected Permission" Command="{Binding AssignPermissionCommand}"
                                Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,15,0,0" Width="180" />

                        <TextBlock Text="Assigned Permissions" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,20,0,8" />
                        <DataGrid ItemsSource="{Binding RolePermissions}" Style="{StaticResource DataGridStyle}" AutoGenerateColumns="False" Height="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120" />
                                <DataGridTemplateColumn Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Remove" Command="{Binding DataContext.RemovePermissionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource DangerButton}" FontSize="11" Padding="6,2" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                   FontSize="12" Margin="20,10,0,0" TextWrapping="Wrap" />
    </Grid>
</UserControl>
