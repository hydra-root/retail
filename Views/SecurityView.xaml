<UserControl x:Class="RetailBillingApp.Views.SecurityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1100">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Security &amp; Encryption" Style="{StaticResource HeadingTextBlock}" />
            <TextBlock Text="Encrypted data at rest (SEC-03): which stored secrets are protected, whether the database file itself is encrypted, and how to move toward that safely."
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" />
        </StackPanel>

        <!-- Busy -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="12" Margin="0,0,0,12"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Loading security state…" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
        </Border>

        <ScrollViewer Grid.Row="2" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Whole-database status -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Database file (app.db)" Style="{StaticResource SubHeadingTextBlock}" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding DatabaseStateLine}" FontSize="13" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding DatabaseProbeNote}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource WarningBrush}" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding MasterPasswordState}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding BackupStateLine}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Stored-secret inventory -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SubHeadingTextBlock}" Margin="0,0,0,8">
                            <Run Text="Stored secrets — protected: " /><Run Text="{Binding ProtectedSecretCount, Mode=OneWay}" /><Run Text="  ·  in the clear: " /><Run Text="{Binding PlaintextSecretCount, Mode=OneWay}" />
                        </TextBlock>

                        <!-- Warning shown only when something is still in the clear -->
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="10" Margin="0,0,0,10"
                                BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                                Visibility="{Binding PlaintextSecretCount, Converter={StaticResource IntToVisibilityConverter}}">
                            <TextBlock Text="Some stored secrets are still readable in the clear. 'Protect stored secrets now' encrypts them with DPAPI while the app keeps running — no restart, no downtime."
                                       FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" />
                        </Border>

                        <DataGrid ItemsSource="{Binding Inventory}" Style="{StaticResource DataGridStyle}"
                                  AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="240">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Secret" Binding="{Binding DisplayName}" Width="170" />
                                <DataGridTextColumn Header="Stored in" Binding="{Binding Location}" Width="240" />
                                <DataGridTextColumn Header="State" Binding="{Binding StateLabel}" Width="140" />
                                <DataGridTextColumn Header="Detail" Binding="{Binding Note}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Margin="0,14,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   Visibility="{Binding HasPlaintextSecrets, Converter={StaticResource BoolToVisibilityConverter}}"
                                   Text="The HQ sync API key is intentionally left in the clear by this screen until the live transport decrypts on read (SEC-08); see its detail row." />

                        <Button Content="Protect stored secrets now" Command="{Binding ProtectSecretsCommand}"
                                Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" MinWidth="200" Margin="0,14,0,0"
                                IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}" />
                    </StackPanel>
                </Border>

                <!-- Whole-database encryption: opt-in, disabled by default -->
                <Border Style="{StaticResource CardBorder}" BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Encrypt the whole database (advanced, opt-in)" Style="{StaticResource SubHeadingTextBlock}" Margin="0,0,0,8" />
                        <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" Margin="0,0,0,10">
                            <Run Text="Re-keying app.db with SQLCipher is irreversible without a backup and is NOT performed automatically. " />
                            <Run Text="This control unlocks only when a backup exists and both acknowledgements are ticked — and even then it shows the manual procedure instead of touching your file." />
                        </TextBlock>

                        <CheckBox Content="I confirm this is the only user of the database right now"
                                  IsChecked="{Binding SingleUserConfirmed}" Margin="0,0,0,6" FontSize="12" />
                        <CheckBox Content="I understand re-keying is not reversible without my backup, and I have verified the backup restores"
                                  IsChecked="{Binding RiskAcknowledged}" Margin="0,0,0,10" FontSize="12" />

                        <Button Content="Encrypt database…" Command="{Binding EncryptDatabaseCommand}"
                                Style="{StaticResource DangerButton}" HorizontalAlignment="Left" MinWidth="200"
                                IsEnabled="{Binding CanAttemptEncrypt}" />

                        <TextBox Text="{Binding MigrationPlanText, Mode=OneWay}" Style="{StaticResource BaseTextBox}"
                                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Height="220" Margin="0,14,0,0"
                                 FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Messages -->
        <StackPanel Grid.Row="4" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" FontSize="12"
                       TextWrapping="Wrap" Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" FontSize="12"
                       TextWrapping="Wrap" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />
            <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Left" MinWidth="120" Margin="0,8,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
