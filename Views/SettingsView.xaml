<UserControl x:Class="RetailBillingApp.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="20">
        <ScrollViewer>
            <StackPanel>

                <TextBlock Text="Settings &amp; Backup" Style="{StaticResource HeadingTextBlock}" Margin="0,0,0,30" />

                <!-- Company Profile -->
                <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Company Profile" Style="{StaticResource SubHeadingTextBlock}" Margin="0,0,0,15" />
                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Company Name" FontWeight="SemiBold" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" />
                        <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1"
                                 Style="{StaticResource BaseTextBox}" Margin="20,0,0,0" />

                        <TextBlock Text="Address" FontWeight="SemiBold" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" />
                        <TextBox Text="{Binding CompanyAddress, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1"
                                 Style="{StaticResource BaseTextBox}" Margin="20,0,0,0" />

                        <TextBlock Text="GST Number" FontWeight="SemiBold" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" />
                        <TextBox Text="{Binding CompanyGstNumber, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1"
                                 Style="{StaticResource BaseTextBox}" Margin="20,0,0,0" />

                        <TextBlock Text="Phone" FontWeight="SemiBold" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" />
                        <TextBox Text="{Binding CompanyPhone, UpdateSourceTrigger=PropertyChanged}" Grid.Row="3" Grid.Column="1"
                                 Style="{StaticResource BaseTextBox}" Margin="20,0,0,0" />
                    </Grid>
                    </StackPanel>
                </Border>

                <!-- Backup & Restore -->
                <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Data Backup &amp; Restore" Style="{StaticResource SubHeadingTextBlock}" Margin="0,0,0,15" />
                        <StackPanel Orientation="Vertical">
                            <Button Content="Backup Database" Command="{Binding BackupCommand}"
                                Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,0,0,10" Width="160" />
                            <Button Content="Restore Database" Command="{Binding RestoreCommand}"
                                Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,0,0,10" Width="160" />
                            <Button Content="Verify Database" Command="{Binding VerifyDatabaseCommand}"
                                Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,0,0,10" Width="160" />
                            <Button Content="List Backups" Command="{Binding ListBackupsCommand}"
                                Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,0,0,10" Width="160" />
                            <Button Content="Check DB Size" Command="{Binding GetDbSizeCommand}"
                                Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,0,0,10" Width="160" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                            <TextBlock Text="Database health: " FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DatabaseHealth}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,15,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Security -->
                <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Security" Style="{StaticResource SubHeadingTextBlock}" Margin="0,0,0,15" />
                        <StackPanel>
                            <CheckBox Content="Enable passcode for critical operations" Margin="0,0,0,10" />
                            <CheckBox Content="Auto-backup daily" IsChecked="True" Margin="0,0,0,10" />
                            <CheckBox Content="Require login on startup" IsChecked="True" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
