<UserControl x:Class="RetailBillingApp.Views.ReceivablesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1100">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="Receivables (Customer Outstanding)" Style="{StaticResource HeadingTextBlock}" />
        </StackPanel>

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource BaseTextBox}" MinWidth="220" />
            <Button Content="Refresh" Command="{Binding RefreshCommand}"
                    Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" />
            <Button Content="Export CSV" Command="{Binding ExportCsvCommand}"
                    Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" />
        </StackPanel>

        <!-- Total -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,0,0,15" HorizontalAlignment="Left" MinWidth="300">
            <StackPanel Margin="15">
                <TextBlock Text="Total Outstanding from Customers" Style="{StaticResource SubHeadingTextBlock}" FontSize="11" />
                <TextBlock Text="{Binding TotalOutstanding, StringFormat={}{0:C}}" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource SuccessBrush}" />
            </StackPanel>
        </Border>

        <!-- Receivables grid with ageing -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}">
            <DataGrid ItemsSource="{Binding FilteredReceivables}" Style="{StaticResource DataGridStyle}"
                      AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*" />
                    <DataGridTextColumn Header="Pending Invoices" Binding="{Binding PendingInvoices}" Width="110" />
                    <DataGridTextColumn Header="Total Outstanding" Binding="{Binding OutstandingAmount, StringFormat=C}" Width="140" />
                    <DataGridTextColumn Header="Current (0-30)" Binding="{Binding Current, StringFormat=C}" Width="130" />
                    <DataGridTextColumn Header="31-60" Binding="{Binding Days31To60, StringFormat=C}" Width="110" />
                    <DataGridTextColumn Header="61-90" Binding="{Binding Days61To90, StringFormat=C}" Width="110" />
                    <DataGridTextColumn Header="90+" Binding="{Binding Days90Plus, StringFormat=C}" Width="110" />
                    <DataGridTextColumn Header="Oldest Invoice" Binding="{Binding OldestInvoiceDate, StringFormat=dd-MMM-yyyy}" Width="120" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="4" Text="{Binding SuccessMessage}" Foreground="{StaticResource SuccessBrush}"
                   FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" />
    </Grid>
</UserControl>
