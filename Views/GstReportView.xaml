<UserControl x:Class="RetailBillingApp.Views.GstReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1100">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header + toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="GST Reports (GSTR-1 / GSTR-3B)" Style="{StaticResource HeadingTextBlock}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <DatePicker SelectedDate="{Binding StartDate}" Style="{StaticResource BaseDatePicker}" />
                <TextBlock Text="To:" VerticalAlignment="Center" Margin="10,0,8,0" />
                <DatePicker SelectedDate="{Binding EndDate}" Style="{StaticResource BaseDatePicker}" />
                <Button Content="Load" Command="{Binding RefreshCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" MinWidth="90" />
            </StackPanel>
        </Grid>

        <!-- Export toolbar -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" Margin="12">
                <Button Content="Export GSTR-1 JSON" Command="{Binding ExportGstr1JsonCommand}"
                        Style="{StaticResource PrimaryButton}" MinWidth="160" />
                <Button Content="Export GSTR-3B JSON" Command="{Binding ExportGstr3bJsonCommand}"
                        Style="{StaticResource SecondaryButton}" MinWidth="160" Margin="10,0,0,0" />
            </StackPanel>
        </Border>

        <!-- GSTR-3B summary cards -->
        <UniformGrid Grid.Row="2" Columns="6" Margin="0,0,0,15">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="Taxable Value" Style="{StaticResource SubHeadingTextBlock}" FontSize="11" />
                    <TextBlock Text="{Binding Gstr3b.OutwardTaxableValue, StringFormat={}{0:C}}" FontSize="16" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="CGST" Style="{StaticResource SubHeadingTextBlock}" FontSize="11" />
                    <TextBlock Text="{Binding Gstr3b.OutwardCGST, StringFormat={}{0:C}}" FontSize="16" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="SGST" Style="{StaticResource SubHeadingTextBlock}" FontSize="11" />
                    <TextBlock Text="{Binding Gstr3b.OutwardSGST, StringFormat={}{0:C}}" FontSize="16" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="IGST" Style="{StaticResource SubHeadingTextBlock}" FontSize="11" />
                    <TextBlock Text="{Binding Gstr3b.OutwardIGST, StringFormat={}{0:C}}" FontSize="16" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="Input Tax Credit" Style="{StaticResource SubHeadingTextBlock}" FontSize="11" />
                    <TextBlock Text="{Binding Gstr3b.InputTaxCredit, StringFormat={}{0:C}}" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource SuccessBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Padding="12">
                <StackPanel>
                    <TextBlock Text="Net Tax Payable" Style="{StaticResource SubHeadingTextBlock}" FontSize="11" />
                    <TextBlock Text="{Binding Gstr3b.NetTaxPayable, StringFormat={}{0:C}}" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource ErrorBrush}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Tabs: B2B / B2C / CDNR / HSN -->
        <TabControl Grid.Row="3" Background="Transparent" BorderThickness="0">
            <TabItem Header="B2B Invoices (Table 4)">
                <Border Style="{StaticResource CardBorder}" Padding="12">
                    <DataGrid ItemsSource="{Binding B2bInvoices}" Style="{StaticResource DataGridStyle}"
                              AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Invoice #" Binding="{Binding InvoiceNumber}" Width="140" />
                            <DataGridTextColumn Header="Date" Binding="{Binding InvoiceDate, StringFormat=dd-MMM-yyyy}" Width="100" />
                            <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="160" />
                            <DataGridTextColumn Header="GSTIN" Binding="{Binding CustomerGstin}" Width="130" />
                            <DataGridTextColumn Header="Taxable Value" Binding="{Binding TaxableValue, StringFormat=C}" Width="120" />
                            <DataGridTextColumn Header="CGST" Binding="{Binding Cgst, StringFormat=C}" Width="90" />
                            <DataGridTextColumn Header="SGST" Binding="{Binding Sgst, StringFormat=C}" Width="90" />
                            <DataGridTextColumn Header="IGST" Binding="{Binding Igst, StringFormat=C}" Width="90" />
                            <DataGridTextColumn Header="Invoice Value" Binding="{Binding InvoiceValue, StringFormat=C}" Width="120" />
                            <DataGridTextColumn Header="Place" Binding="{Binding PlaceOfSupply}" Width="*" />
                            <DataGridTextColumn Header="Type" Binding="{Binding InvoiceType}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

            <TabItem Header="B2C Invoices (Table 5/7)">
                <Border Style="{StaticResource CardBorder}" Padding="12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="B2C Total: " Style="{StaticResource SubHeadingTextBlock}" FontSize="13" />
                            <TextBlock Text="{Binding TotalB2c, StringFormat={}{0:C}}" FontSize="14" FontWeight="Bold" />
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding B2cInvoices}" Style="{StaticResource DataGridStyle}"
                                  AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Invoice #" Binding="{Binding InvoiceNumber}" Width="140" />
                                <DataGridTextColumn Header="Date" Binding="{Binding InvoiceDate, StringFormat=dd-MMM-yyyy}" Width="100" />
                                <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="200" />
                                <DataGridTextColumn Header="Taxable Value" Binding="{Binding TaxableValue, StringFormat=C}" Width="120" />
                                <DataGridTextColumn Header="CGST" Binding="{Binding Cgst, StringFormat=C}" Width="90" />
                                <DataGridTextColumn Header="SGST" Binding="{Binding Sgst, StringFormat=C}" Width="90" />
                                <DataGridTextColumn Header="IGST" Binding="{Binding Igst, StringFormat=C}" Width="90" />
                                <DataGridTextColumn Header="Invoice Value" Binding="{Binding InvoiceValue, StringFormat=C}" Width="120" />
                                <DataGridTextColumn Header="Place" Binding="{Binding PlaceOfSupply}" Width="*" />
                                <DataGridTextColumn Header="Bill of Supply" Binding="{Binding IsBillOfSupply}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>

            <TabItem Header="Credit Notes - CDNR (Table 9B)">
                <Border Style="{StaticResource CardBorder}" Padding="12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="CDNR Total: " Style="{StaticResource SubHeadingTextBlock}" FontSize="13" />
                            <TextBlock Text="{Binding TotalCdnr, StringFormat={}{0:C}}" FontSize="14" FontWeight="Bold" />
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding CreditNotes}" Style="{StaticResource DataGridStyle}"
                                  AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Credit Note #" Binding="{Binding CreditNoteNumber}" Width="140" />
                                <DataGridTextColumn Header="Date" Binding="{Binding CreditNoteDate, StringFormat=dd-MMM-yyyy}" Width="100" />
                                <DataGridTextColumn Header="Original Invoice #" Binding="{Binding OriginalInvoiceNumber}" Width="150" />
                                <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="180" />
                                <DataGridTextColumn Header="GSTIN" Binding="{Binding CustomerGstin}" Width="130" />
                                <DataGridTextColumn Header="Taxable Value" Binding="{Binding TaxableValue, StringFormat=C}" Width="120" />
                                <DataGridTextColumn Header="Tax" Binding="{Binding TaxValue, StringFormat=C}" Width="100" />
                                <DataGridTextColumn Header="Note Value" Binding="{Binding CreditNoteValue, StringFormat=C}" Width="120" />
                                <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>

            <TabItem Header="HSN Summary (Table 12)">
                <Border Style="{StaticResource CardBorder}" Padding="12">
                    <DataGrid ItemsSource="{Binding HsnSummary}" Style="{StaticResource DataGridStyle}"
                              AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="HSN Code" Binding="{Binding HsnCode}" Width="120" />
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                            <DataGridTextColumn Header="Qty" Binding="{Binding Uqc}" Width="80" />
                            <DataGridTextColumn Header="Taxable Value" Binding="{Binding TaxableValue, StringFormat=C}" Width="120" />
                            <DataGridTextColumn Header="CGST" Binding="{Binding Cgst, StringFormat=C}" Width="100" />
                            <DataGridTextColumn Header="SGST" Binding="{Binding Sgst, StringFormat=C}" Width="100" />
                            <DataGridTextColumn Header="IGST" Binding="{Binding Igst, StringFormat=C}" Width="100" />
                            <DataGridTextColumn Header="Total Tax" Binding="{Binding TotalTax, StringFormat=C}" Width="110" />
                            <DataGridTextColumn Header="Total Value" Binding="{Binding TotalValue, StringFormat=C}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Messages -->
        <StackPanel Grid.Row="3" VerticalAlignment="Bottom" Margin="0,8,0,0">
            <TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource SuccessBrush}"
                       FontSize="12" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                       FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
