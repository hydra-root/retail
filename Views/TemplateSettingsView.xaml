<UserControl x:Class="RetailBillingApp.Views.TemplateSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1100">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Invoice Templates" Style="{StaticResource HeadingTextBlock}" />
            <TextBlock Text="Logo, terms and branding for the GST invoice / thermal print template"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,5,0,0" />
        </StackPanel>

        <!-- Settings + Preview cards -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="1.2*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- Settings card -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <TextBlock Text="Branding &amp; Layout" Style="{StaticResource SubHeadingTextBlock}" Margin="0,0,0,10" />

                        <TextBlock Text="Template Name" FontSize="12" Margin="0,5,0,4" />
                        <ComboBox ItemsSource="{Binding TemplateNames}"
                                  SelectedItem="{Binding TemplateName}"
                                  Style="{StaticResource BaseComboBox}"
                                  MinWidth="200" HorizontalAlignment="Left" />

                        <TextBlock Text="Header Text (business name / tagline)" FontSize="12" Margin="0,14,0,4" />
                        <TextBox Text="{Binding HeaderText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}"
                                 AcceptsReturn="False" MaxLength="200" />

                        <TextBlock Text="Footer Text (bank details / UPI note)" FontSize="12" Margin="0,14,0,4" />
                        <TextBox Text="{Binding FooterText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="80"
                                 VerticalScrollBarVisibility="Auto" MaxLength="1000" />

                        <TextBlock Text="Terms &amp; Conditions" FontSize="12" Margin="0,14,0,4" />
                        <TextBox Text="{Binding TermsText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="110"
                                 VerticalScrollBarVisibility="Auto" MaxLength="1000" />

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <CheckBox Content="Show Logo" IsChecked="{Binding ShowLogo}" Margin="0,0,25,0" />
                            <CheckBox Content="Show Tax Breakup" IsChecked="{Binding ShowTaxBreakup}" Margin="0,0,25,0" />
                            <CheckBox Content="Show Signature Line" IsChecked="{Binding ShowSignatureLine}" />
                        </StackPanel>

                        <TextBlock Text="Signature Caption" FontSize="12" Margin="0,18,0,4" />
                        <TextBox Text="{Binding SignatureCaption, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBox}"
                                 HorizontalAlignment="Left" MinWidth="260"
                                 IsEnabled="{Binding ShowSignatureLine}" MaxLength="200" />

                        <TextBlock Text="Logo (PNG / JPG)" FontSize="12" Margin="0,18,0,4" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding LogoPath, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource BaseTextBox}" MinWidth="280"
                                     MaxLength="500" />
                            <Button Content="Browse" Command="{Binding BrowseLogoCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
                        </StackPanel>

                        <Button Content="Save Settings" Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left" MinWidth="140" Margin="0,20,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Preview card -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Template Preview" Style="{StaticResource SubHeadingTextBlock}"
                                   VerticalAlignment="Center" />
                        <Button Content="Refresh Preview" Command="{Binding RefreshPreviewCommand}"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <TextBox Grid.Row="1" Text="{Binding PreviewText, Mode=OneWay}"
                             IsReadOnly="True" FontFamily="Consolas" FontSize="13"
                             TextWrapping="NoWrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Background="{StaticResource BackgroundBrush}"
                             BorderThickness="0" />
                </Grid>
            </Border>
        </Grid>

        <!-- Messages -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource SuccessBrush}"
                       FontSize="12" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                       FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
