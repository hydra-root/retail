<UserControl x:Class="RetailBillingApp.Views.StockTransferView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header + dispatch toolbar -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Stock Transfer" Style="{StaticResource HeadingTextBlock}" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox ItemsSource="{Binding Stores}" SelectedItem="{Binding FromStore}"
                          DisplayMemberPath="Name" Style="{StaticResource BaseComboBox}" MinWidth="140" />
                <TextBlock Text="To:" VerticalAlignment="Center" Margin="15,0,8,0" />
                <ComboBox ItemsSource="{Binding Stores}" SelectedItem="{Binding ToStore}"
                          DisplayMemberPath="Name" Style="{StaticResource BaseComboBox}" MinWidth="140" />
                <TextBlock Text="Product:" VerticalAlignment="Center" Margin="15,0,8,0" />
                <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
                          DisplayMemberPath="Name" Style="{StaticResource BaseComboBox}" MinWidth="180" />
                <TextBlock Text="Qty:" VerticalAlignment="Center" Margin="15,0,8,0" />
                <TextBox Text="{Binding Quantity}" Style="{StaticResource BaseTextBox}" MinWidth="70" />
                <Button Content="Transfer" Command="{Binding CreateTransferCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="15,0,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- KPI cards -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,15">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                <StackPanel Margin="15">
                    <TextBlock Text="In-Transit Transfers" Style="{StaticResource SubHeadingTextBlock}" FontSize="11" />
                    <TextBlock Text="{Binding InTransitCount}" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                <StackPanel Margin="15">
                    <TextBlock Text="Received Transfers" Style="{StaticResource SubHeadingTextBlock}" FontSize="11" />
                    <TextBlock Text="{Binding ReceivedCount}" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource SuccessBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <StackPanel Margin="15">
                    <TextBlock Text="Total Value In-Transit" Style="{StaticResource SubHeadingTextBlock}" FontSize="11" />
                    <TextBlock Text="{Binding TotalValueInTransit, StringFormat={}{0:C}}" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource SuccessBrush}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Grid + filter -->
        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Status:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}"
                          Style="{StaticResource BaseComboBox}" MinWidth="120" />
                <Button Content="Refresh" Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" />
                <Button Content="Receive" Command="{Binding ReceiveCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="20,0,0,0" />
                <Button Content="Cancel" Command="{Binding CancelTransferCommand}"
                        Style="{StaticResource DangerButton}" Margin="10,0,0,0" />
                <TextBlock Text="(Receive/Cancel apply to the selected row)"
                           VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11"
                           Foreground="{StaticResource PrimaryBrush}" />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource CardBorder}">
                <DataGrid ItemsSource="{Binding Transfers}" SelectedItem="{Binding SelectedTransfer}"
                          Style="{StaticResource DataGridStyle}"
                          AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Transfer #" Binding="{Binding TransferNumber}" Width="170" />
                        <DataGridTextColumn Header="Date" Binding="{Binding TransferDate, StringFormat=dd-MMM-yyyy HH:mm}" Width="140" />
                        <DataGridTextColumn Header="From" Binding="{Binding FromStoreName}" Width="120" />
                        <DataGridTextColumn Header="To" Binding="{Binding ToStoreName}" Width="120" />
                        <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*" />
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="70" />
                        <DataGridTextColumn Header="Value" Binding="{Binding TransferValue, StringFormat=C}" Width="110" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                        <DataGridTextColumn Header="Received Date" Binding="{Binding ReceivedDate, StringFormat=dd-MMM-yyyy HH:mm}" Width="140" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Messages -->
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource SuccessBrush}"
                       FontSize="12" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                       FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
